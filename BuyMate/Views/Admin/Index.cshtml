@{
    ViewData["Title"] = "Admin Dashboard";

    var cards = new[]
    {
        new { Title = "Products", Desc = "Create, edit, and delete products.", Icon = "fa-box-open", TargetController = "Product", TargetAction = "Index", HasCreate = true, FooterText = "" },
        new { Title = "Categories", Desc = "Organize products by categories.", Icon = "fa-tags", TargetController = "Category", TargetAction = "Index", HasCreate = true, FooterText = "" },
        new { Title = "Orders", Desc = "Manage customer orders.", Icon = "fa-shopping-cart", TargetController = "Order", TargetAction = "GetAll", HasCreate = false, FooterText = "View and process orders" },
        new { Title = "Analytics", Desc = "Add sales and inventory KPIs here.", Icon = "fa-chart-line", TargetController = "", TargetAction = "", HasCreate = false, FooterText = "Coming soon..." }
    };
}

<div class="container mb-5">
    <div class="rounded-3 text-white p-4 p-md-5 mb-4 shadow" style="background:linear-gradient(135deg,#4c1d95 0%,#7c3aed 45%,#e9d5ff 140%);">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-md-between gap-3">
            <div>
                <h1 class="h4 fw-bold mb-1">Admin Dashboard</h1>
                <p class="small text-white-50 mb-0">Control center for products & categories management.</p>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <a asp-controller="Product" asp-action="Create" class="btn btn-outline-light btn-sm d-inline-flex align-items-center gap-1">
                    <i class="fas fa-plus"></i>
                    <span>New Product</span>
                </a>
                <a asp-controller="Category" asp-action="Create" class="btn btn-outline-light btn-sm d-inline-flex align-items-center gap-1">
                    <i class="fas fa-folder-plus"></i>
                    <span>New Category</span>
                </a>
            </div>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var card in cards)
        {
            var hasUrl = !string.IsNullOrEmpty(card.TargetController) && !string.IsNullOrEmpty(card.TargetAction);
            var onClickAttr = hasUrl ? $"location.href='{Url.Action(card.TargetAction, card.TargetController)}'" : null;
            var cursorStyle = hasUrl ? "cursor:pointer;" : null;

            <div class="col-12 col-sm-6 col-lg-3">
                <div class="card h-100 border-purple shadow-sm" style="@cursorStyle" onclick="@onClickAttr">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex align-items-start justify-content-between mb-3">
                            <div>
                                <h3 class="small fw-bold text-dark mb-1">@card.Title</h3>
                                <p class="small text-muted mb-0">@card.Desc</p>
                            </div>
                            <div class="rounded bg-light d-flex align-items-center justify-content-center text-dark" style="width:3rem;height:3rem;">
                                <i class="fas @card.Icon"></i>
                            </div>
                        </div>
                        <div class="mt-auto @(!card.HasCreate ? "small text-muted" : "")">
                            @if (card.HasCreate)
                            {
                                <a asp-controller="@card.TargetController" asp-action="Create" class="btn btn-dark btn-sm w-100" onclick="event.stopPropagation();">
                                    <i class="fas fa-plus me-1"></i> Create New
                                </a>
                            }
                            else
                            {
                                @card.FooterText
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
