@{
    ViewData["Title"] = "Admin Dashboard";

    var cards = new[]
    {
        new { Title = "Products", Desc = "Create, edit, and delete products easily.", Icon = "fa-box-open text-primary", BgColor = "bg-primary bg-opacity-10", TargetController = "Product", TargetAction = "Index", HasCreate = true, FooterText = "" },
        new { Title = "Categories", Desc = "Organize products by creating categories.", Icon = "fa-tags text-success", BgColor = "bg-success bg-opacity-10", TargetController = "Category", TargetAction = "Index", HasCreate = true, FooterText = "" },
        new { Title = "Orders", Desc = "Manage and fulfill customer orders.", Icon = "fa-shopping-cart text-warning", BgColor = "bg-warning bg-opacity-10", TargetController = "Order", TargetAction = "GetAll", HasCreate = false, FooterText = "View and process orders" },
        new { Title = "Analytics", Desc = "View sales and inventory metrics.", Icon = "fa-chart-line text-info", BgColor = "bg-info bg-opacity-10", TargetController = "", TargetAction = "", HasCreate = false, FooterText = "Coming soon..." }
    };
}

<div class="container mb-5" style="max-width: 72rem;">
    <div class="d-flex align-items-center justify-content-between mb-4 mt-4">
        <h1 class="h3 fw-bold mb-0">Admin Dashboard</h1>
    </div>

    <!-- Header Banner -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
        <div class="card-body p-4 p-md-5 text-white position-relative" style="background: linear-gradient(135deg, #212529 0%, #343a40 100%);">
            <div class="position-absolute top-0 end-0 opacity-10" style="font-size: 15rem; transform: translate(20%, -30%);">
                <i class="fas fa-cogs"></i>
            </div>
            <div class="position-relative z-1">
                <h2 class="h3 fw-bold mb-2">Welcome Back, Admin!</h2>
                <p class="text-white-50 mb-4 fs-5" style="max-width: 600px;">Control center for managing your products, categories, orders, and overall platform settings.</p>
                <div class="d-flex flex-wrap align-items-center gap-3">
                    <a asp-controller="Product" asp-action="Create" class="btn btn-light rounded-pill px-4 fw-bold shadow-sm hover-lift d-inline-flex align-items-center">
                        <i class="fas fa-plus me-2 text-primary"></i> New Product
                    </a>
                    <a asp-controller="Category" asp-action="Create" class="btn btn-outline-light rounded-pill px-4 fw-bold hover-lift d-inline-flex align-items-center">
                        <i class="fas fa-folder-plus me-2"></i> New Category
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex align-items-center mb-4">
        <h2 class="h5 fw-bold mb-0"><i class="fas fa-th-large me-2 text-primary"></i>Quick Access</h2>
    </div>

    <!-- Quick Links Grid -->
    <div class="row g-4">
        @foreach (var card in cards)
        {
            var hasUrl = !string.IsNullOrEmpty(card.TargetController) && !string.IsNullOrEmpty(card.TargetAction);
            var onClickAttr = hasUrl ? $"location.href='{Url.Action(card.TargetAction, card.TargetController)}'" : null;
            var cursorStyle = hasUrl ? "cursor: pointer;" : null;

            <div class="col-12 col-md-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 h-100 hover-lift overflow-hidden" style="@cursorStyle" onclick="@onClickAttr">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex align-items-start justify-content-between mb-4">
                            <div class="rounded-circle @card.BgColor d-flex align-items-center justify-content-center" style="width: 3.5rem; height: 3.5rem;">
                                <i class="fas @card.Icon fs-4"></i>
                            </div>
                        </div>
                        <div>
                            <h3 class="h5 fw-bold text-dark mb-2">@card.Title</h3>
                            <p class="text-muted small mb-0">@card.Desc</p>
                        </div>
                        <div class="mt-auto pt-4">
                            @if (card.HasCreate)
                            {
                                <a asp-controller="@card.TargetController" asp-action="Create" class="btn btn-dark btn-sm rounded-pill px-3 py-2 w-100 fw-semibold" onclick="event.stopPropagation();">
                                    <i class="fas fa-plus me-1"></i> Create New
                                </a>
                            }
                            else
                            {
                                <span class="d-block w-100 text-center text-muted small fw-medium py-2 px-3 bg-light rounded-pill border">
                                    <i class="@((hasUrl) ? "fas fa-arrow-right me-1" : "fas fa-clock me-1")"></i> @card.FooterText
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .hover-lift { transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .hover-lift:hover { transform: translateY(-4px); box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important; }
</style>
