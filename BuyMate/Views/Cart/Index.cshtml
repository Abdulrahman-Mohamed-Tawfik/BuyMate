@using BuyMate.DTO.ViewModels.Cart
@model CartViewModel

@{
    ViewData["Title"] = "Shopping Cart";
    var requestToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}

<div class="container mb-5" style="max-width: 72rem;">
    <input type="hidden" id="__RequestVerificationToken" value="@requestToken" />

    <h1 class="h3 fw-bold mb-4">Shopping Cart</h1>

    @if (Model is not null && Model.Items.Count != 0)
    {
        <div class="row g-4">
            <div class="col-12 col-lg-8">
                <div class="d-flex flex-column gap-3">
                    @foreach (var item in Model.Items)
                    {
                        <div class="card p-3 shadow-sm border-0">
                            <div class="d-flex align-items-center gap-3">
                                <img src="/images/@(item.ImageUrl ?? "placeholder.png")" alt="@item.ProductName" class="rounded" style="width:80px;height:80px;object-fit:contain;" />
                                <div class="flex-grow-1">
                                    <h3 class="h6 fw-semibold mb-1">@item.ProductName</h3>
                                    <div class="d-flex align-items-center flex-wrap gap-3 mt-1">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="small">Quantity:</span>
                                            <div class="input-group input-group-sm" style="width:auto;">
                                                <button type="button" class="btn btn-outline-secondary" onclick="changeItemQuantity('@item.ItemId', -1)" @(item.Quantity <= 1 ? "disabled" : "")>-</button>
                                                <input id="qty-@item.ItemId" type="text" class="form-control text-center" style="max-width:3rem;" value="@item.Quantity" readonly data-stock="@item.StockQuantity" />
                                                <button type="button" class="btn btn-outline-secondary" onclick="changeItemQuantity('@item.ItemId', 1)" @(item.Quantity >= item.StockQuantity ? "disabled" : "")>+</button>
                                            </div>
                                        </div>
                                        <span class="fw-bold" id="item-total-@item.ItemId">$@item.TotalPrice</span>
                                    </div>
                                </div>
                                <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeFromCart('@item.ItemId')">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="col-12 col-lg-4">
                <div class="card p-3 shadow-sm border-0 sticky-top" style="top: 6rem; z-index: 1020;">
                    <h2 class="h5 fw-bold mb-3">Order Summary</h2>
                    <div class="d-flex flex-column gap-2 mb-2">
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Subtotal</span>
                            <span class="fw-medium" id="cart-subtotal">$@Model.Subtotal</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Shipping</span>
                            <span class="fw-medium">Free</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Tax</span>
                            <span class="fw-medium">$0.00</span>
                        </div>
                        <hr class="my-3" />
                        <div class="d-flex justify-content-between fw-bold fs-5">
                            <span>Total</span>
                            <span id="cart-total">$@Model.Total</span>
                        </div>
                    </div>
                    <div class="mt-4 d-flex flex-column gap-2">
                        <a asp-controller="Order" asp-action="Checkout" class="btn btn-dark w-100 py-2">
                            Proceed to Checkout
                        </a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary w-100 py-2">
                            Continue Shopping
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fa-solid fa-cart-shopping fa-3x text-muted mb-3"></i>
            <h2 class="h4 fw-bold mb-2">Your cart is empty</h2>
            <p class="text-muted mb-3">Looks like you haven't added any items to your cart yet.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-dark btn-lg">
                Start Shopping
            </a>
        </div>
    }
</div>

<script src="~/js/cart.js"></script>
