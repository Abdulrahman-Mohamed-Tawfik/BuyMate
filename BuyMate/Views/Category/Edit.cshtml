@using BuyMate.DTO.Entities.Category
@model CreateCategoryDto
@{
    ViewData["Title"] = "Edit Category";
    var categoryId = ViewBag.Id as Guid?;
}

<div class="container mb-5" style="max-width: 48rem;">
    <div class="d-flex align-items-center mb-4 mt-4">
        <a asp-action="Index" class="btn btn-light rounded-circle shadow-sm border p-0 d-flex align-items-center justify-content-center me-3 hover-lift" style="width: 40px; height: 40px; transition: transform 0.2s;">
            <i class="fas fa-arrow-left text-dark"></i>
        </a>
        <h1 class="h3 fw-bold mb-0">Edit Category</h1>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-dark text-white p-4">
            <h2 class="h5 mb-0 fw-semibold"><i class="fas fa-edit me-2"></i>Category Information</h2>
            <p class="small text-white-50 mb-0 mt-1">Update the category name or replace its image.</p>
        </div>
        <div class="card-body p-4 p-md-5">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success d-flex align-items-center mb-4 border-0 shadow-sm rounded-3">
                    <i class="fas fa-check-circle fs-4 me-2"></i>
                    <div>@TempData["Success"]</div>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger d-flex align-items-center mb-4 border-0 shadow-sm rounded-3">
                    <i class="fas fa-exclamation-triangle fs-4 me-2"></i>
                    <div>@TempData["Error"]</div>
                </div>
            }

            <form asp-controller="Category"
                  asp-action="Edit"
                  asp-route-id="@categoryId"
                  method="post"
                  enctype="multipart/form-data"
                  id="editCategoryForm">
                @Html.AntiForgeryToken()

                <div class="row g-4">
                    <div class="col-12">
                        <div class="bg-light p-4 rounded-4 border mb-4">
                            <h3 class="h6 fw-bold mb-3 text-dark border-bottom pb-2">Basic Details</h3>

                            <div class="mb-3">
                                <label asp-for="Name" class="form-label fw-semibold text-secondary small text-uppercase" style="letter-spacing: 1px;">Category Name</label>
                                <input asp-for="Name" class="form-control form-control-lg border-0 shadow-sm" placeholder="Enter category name..." />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="bg-light p-4 rounded-4 border">
                            <div class="text-center mb-4">
                                <h3 class="h6 fw-bold mb-1 text-dark border-bottom pb-2 text-start">Category Image</h3>
                                <p class="small text-muted text-start mb-3">Leave empty to keep the current image.</p>
                            </div>

                            <div class="text-center p-4 border border-2 border-dashed rounded-4 bg-white hover-bg-light transition-all cursor-pointer mb-3 position-relative" onclick="document.getElementById('imageFile').click()" style="border-style: dashed !important; border-color: #ced4da !important;">
                                <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                                    <i class="fas fa-cloud-upload-alt fa-2x text-primary opacity-75"></i>
                                </div>
                                <h4 class="h5 fw-bold mb-2">Replace Image</h4>
                                <p class="text-muted small mb-0">Allowed: JPG, JPEG, PNG, GIF, WEBP. Max 2MB.</p>
                                <span id="selectedFile" class="badge bg-secondary mt-3 fs-6 px-3 py-2 rounded-pill">No new file chosen</span>
                            </div>

                            <input type="file" name="imageFile" id="imageFile" class="d-none" accept="image/*" />

                            <div id="imagePreview" class="row g-3 justify-content-center mt-2 d-none"></div>

                            <div class="text-end">
                                <button type="button" id="clearImageBtn" class="btn btn-outline-danger btn-sm rounded-pill px-3 d-none">
                                    <i class="fas fa-times me-1"></i> Clear Selection
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="border-top pt-4 mt-4 d-flex justify-content-end gap-3 flex-wrap">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-pill px-4 fw-bold shadow-sm">Cancel</a>
                    <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow-sm hover-lift">
                        <i class="fas fa-save me-2"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-danger border-opacity-25 shadow-sm rounded-4 overflow-hidden bg-danger bg-opacity-10">
        <div class="card-body p-4 d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3">
            <div>
                <h3 class="h6 fw-bold text-danger mb-1"><i class="fas fa-exclamation-triangle me-2"></i>Danger Zone</h3>
                <p class="small text-danger mb-0 opacity-75">Once deleted, this category cannot be recovered.</p>
            </div>

            <form asp-controller="Category"
                  asp-action="Delete"
                  asp-route-id="@categoryId"
                  method="post"
                  id="deleteCategoryForm"
                  class="swal-delete" data-confirm="Delete this category?">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm hover-lift">
                    <i class="fas fa-trash-alt me-2"></i> Delete Category
                </button>
            </form>
        </div>
    </div>
</div>

<style>
    .border-dashed { border-style: dashed !important; border-color: #dee2e6 !important; }
    .cursor-pointer { cursor: pointer; }
    .hover-bg-light:hover { background-color: #f8f9fa !important; }
    .hover-lift { transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .hover-lift:hover { transform: translateY(-2px); box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important; }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/category.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const form = document.querySelector('.swal-delete');
            if (form) {
                form.addEventListener('submit', function (e) {
                    e.preventDefault();
                    Swal.fire({
                        title: 'Are you sure?',
                        text: "You won't be able to revert this!",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#d33',
                        cancelButtonColor: '#3085d6',
                        confirmButtonText: 'Yes, delete it!'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            form.submit();
                        }
                    })
                });
            }
        });
    </script>
}