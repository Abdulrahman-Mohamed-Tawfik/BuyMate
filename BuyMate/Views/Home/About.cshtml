@{
    ViewData["Title"] = "About Us";
}

<div class="container mb-5 mt-4" style="max-width: 64rem;">
    <div class="text-center mb-5 position-relative">
        <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2 mb-3 fw-semibold" style="letter-spacing: 1px;"><i class="fas fa-info-circle me-2"></i>WHO WE ARE</span>
        <h1 class="display-4 fw-bolder mb-3 text-dark" style="letter-spacing: -1px;">About BUYMATE</h1>
        <p class="text-secondary fs-5 mx-auto" style="max-width: 600px;">Getting to know the people and the mission behind your favorite platform.</p>
    </div>

    <div class="row g-4">
        <!-- Our Story -->
        <div class="col-12">
            <div class="card p-4 p-md-5 border-0 shadow-sm rounded-4 bg-white hover-lift transition-all">
                <div class="d-flex align-items-center mb-4">
                    <div class="bg-primary bg-opacity-10 rounded-circle text-primary d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 50px; height: 50px;">
                        <i class="fas fa-book-open fs-4"></i>
                    </div>
                    <h2 class="h3 fw-bold mb-0 text-dark">Our Story</h2>
                </div>
                <p class="text-secondary fs-5 lh-lg mb-0 text-dark">
                    BUYMATE was founded with a simple mission: to make online shopping easier, faster, and more enjoyable for everyone.
                    We believe that finding the perfect product should be effortless, and that's why we've built a platform that
                    combines cutting-edge technology with exceptional customer service.
                </p>
            </div>
        </div>

        <!-- Our Values Section -->
        <div class="col-12">
            <div class="card p-4 p-md-5 border-0 shadow-sm rounded-4 bg-light">
                <div class="text-center mb-5">
                    <h2 class="h3 fw-bold text-dark"><i class="fas fa-gem text-primary me-2"></i>Our Values</h2>
                    <p class="text-secondary fs-6">The principles that guide everything we do</p>
                </div>

                <div class="row g-4">
                    <!-- Value 1 -->
                    <div class="col-12 col-md-4">
                        <div class="card h-100 p-4 border-0 shadow-sm rounded-4 bg-white text-center hover-lift">
                            <div class="rounded-circle bg-success bg-opacity-10 d-flex align-items-center justify-content-center mx-auto mb-4" style="width:4.5rem;height:4.5rem;">
                                <i class="fas fa-check text-success fs-3"></i>
                            </div>
                            <h3 class="h5 fw-bold mb-2">Quality First</h3>
                            <p class="text-secondary mb-0">We only offer products that meet our high standards for quality and reliability.</p>
                        </div>
                    </div>
                    <!-- Value 2 -->
                    <div class="col-12 col-md-4">
                        <div class="card h-100 p-4 border-0 shadow-sm rounded-4 bg-white text-center hover-lift">
                            <div class="rounded-circle bg-warning bg-opacity-10 d-flex align-items-center justify-content-center mx-auto mb-4" style="width:4.5rem;height:4.5rem;">
                                <i class="fas fa-bolt text-warning fs-3"></i>
                            </div>
                            <h3 class="h5 fw-bold mb-2">Lightning Speed</h3>
                            <p class="text-secondary mb-0">Fast delivery and quick customer support to get you what you need, when you need it.</p>
                        </div>
                    </div>
                    <!-- Value 3 -->
                    <div class="col-12 col-md-4">
                        <div class="card h-100 p-4 border-0 shadow-sm rounded-4 bg-white text-center hover-lift">
                            <div class="rounded-circle bg-danger bg-opacity-10 d-flex align-items-center justify-content-center mx-auto mb-4" style="width:4.5rem;height:4.5rem;">
                                <i class="fas fa-heart text-danger fs-3"></i>
                            </div>
                            <h3 class="h5 fw-bold mb-2">Exceptional Care</h3>
                            <p class="text-secondary mb-0">We deeply care about our customers and are committed to your total satisfaction.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Our Team & Contact -->
        <div class="col-12 col-lg-6 d-flex">
            <div class="card p-4 p-md-5 border-0 shadow-sm rounded-4 bg-white w-100 hover-lift">
                <div class="d-flex align-items-center mb-4">
                    <div class="bg-info bg-opacity-10 rounded-circle text-info d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 50px; height: 50px;">
                        <i class="fas fa-users fs-4"></i>
                    </div>
                    <h2 class="h4 fw-bold mb-0 text-dark">Our Team</h2>
                </div>
                <p class="text-secondary fs-6 lh-lg mb-0 text-dark">
                    Our team consists of passionate individuals dedicated to creating the best online shopping ecosystem.
                    From the creative developers who build the platform to the dedicated customer service representatives who assist you with your orders,
                    everyone at BUYMATE works together toward an extraordinary experience.
                </p>
            </div>
        </div>

        <div class="col-12 col-lg-6 d-flex">
            <div class="card p-4 p-md-5 border-0 shadow-sm rounded-4 bg-dark text-white w-100 hover-lift position-relative overflow-hidden">
                <div class="position-absolute top-0 end-0 opacity-10" style="transform: translate(20%, -20%); background: radial-gradient(circle, #fff 0%, transparent 70%); width: 200px; height: 200px; border-radius: 50%;"></div>
                <div class="d-flex align-items-center mb-4 position-relative z-index-1">
                    <div class="bg-white bg-opacity-25 rounded-circle text-white d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 50px; height: 50px;">
                        <i class="fas fa-address-card fs-4"></i>
                    </div>
                    <h2 class="h4 fw-bold mb-0">Contact Information</h2>
                </div>

                <div class="row g-4 position-relative z-index-1">
                    <div class="col-sm-6">
                        <div class="d-flex flex-column">
                            <span class="text-white-50 text-uppercase small fw-bold mb-1" style="letter-spacing: 1px;"><i class="fas fa-map-marker-alt me-2"></i>Address</span>
                            <span class="fw-medium">123 Shopping Street<br />E-commerce City, EC 12345</span>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="d-flex flex-column">
                            <span class="text-white-50 text-uppercase small fw-bold mb-1" style="letter-spacing: 1px;"><i class="fas fa-phone-alt me-2"></i>Phone</span>
                            <span class="fw-medium">+1 (555) 123-4567</span>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="d-flex flex-column">
                            <span class="text-white-50 text-uppercase small fw-bold mb-1" style="letter-spacing: 1px;"><i class="fas fa-envelope me-2"></i>Email</span>
                            <span class="fw-medium"><a href="mailto:support@buymate.com" class="text-white text-decoration-none">support@buymate.com</a></span>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="d-flex flex-column">
                            <span class="text-white-50 text-uppercase small fw-bold mb-1" style="letter-spacing: 1px;"><i class="fas fa-clock me-2"></i>Hours</span>
                            <span class="fw-medium">Mon-Fri: 9AM-6PM<br />Sat-Sun: 10AM-4PM</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
