@using BuyMate.DTO.ViewModels.Shop
@model HomeViewModel
@{
    ViewData["Title"] = "Home";
    var requestToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}
<div class="container mb-5 mt-4">
    <input type="hidden" id="__RequestVerificationToken" value="@requestToken" />

    <!-- Hero Section -->
    <section class="text-white p-5 mb-5 text-center position-relative d-flex align-items-center justify-content-center shadow-lg hover-lift" style="min-height: 480px; background-image: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.6)), url('/images/o3.jpg'); background-size: cover; background-position: center; border-radius: 1.5rem; overflow: hidden;">
        <div class="mx-auto position-relative" style="z-index: 2; max-width: 50rem;">
            <span class="badge bg-primary bg-opacity-75 text-white rounded-pill px-3 py-2 mb-3 fw-bold shadow-sm" style="letter-spacing: 2px;"><i class="fas fa-sparkles me-2"></i>PREMIUM EXPERIENCE</span>
            <h1 class="display-3 fw-bolder mb-4 text-white" style="letter-spacing: -1px; text-shadow: 0 4px 12px rgba(0,0,0,0.3);">Welcome to BUYMATE</h1>
            <p class="fs-4 mb-5 text-light fw-medium" style="text-shadow: 0 2px 8px rgba(0,0,0,0.4);">
                Discover amazing products at unbeatable prices, curated just for you.
            </p>
            <div class="d-flex flex-wrap justify-content-center gap-3">
                <a asp-controller="Shop" asp-action="Index" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow-sm hover-scale d-inline-flex align-items-center py-3">
                    <i class="fas fa-shopping-bag me-2"></i> Shop Now
                </a>
                <a asp-controller="Shop" asp-action="Deals" class="btn btn-light btn-lg rounded-pill px-4 fw-bold shadow-sm hover-scale d-inline-flex align-items-center py-3 text-dark">
                    <i class="fas fa-bolt text-warning me-2"></i> Flash Deals
                </a>
            </div>
        </div>
    </section>

    <!-- Featured Categories -->
    <section class="mb-5 mt-5">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <h2 class="h3 fw-bold mb-0 text-dark"><i class="fas fa-layer-group text-primary me-2"></i>Shop by Category</h2>
            <a asp-controller="Shop" asp-action="Categories" class="btn btn-light border rounded-pill btn-sm d-inline-flex align-items-center px-3 fw-bold shadow-sm hover-bg-light">
                View All Categories <i class="fas fa-arrow-right ms-2"></i>
            </a>
        </div>
        <div class="row g-4">
            @if (Model.Categories?.Any() == true)
            {
                @foreach (var category in Model.Categories.Take(8))
                {
                    <div class="col-6 col-md-4 col-xl-3 hover-lift">
                        <partial name="_CategoryTile" model="category" />
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="text-center py-5 bg-light rounded-4 text-muted border border-dashed rounded-4">
                        <div class="d-inline-flex justify-content-center align-items-center bg-white rounded-circle shadow-sm mb-3" style="width: 80px; height: 80px;">
                            <i class="fas fa-folder-open fa-2x text-muted" style="opacity: 0.5;"></i>
                        </div>
                        <p class="mb-0 fs-5 fw-medium">Categories will be available soon.</p>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- Featured Products -->
    <section class="mb-5 mt-5">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div class="d-flex align-items-center">
                <h2 class="h3 fw-bold mb-0 text-dark"><i class="fas fa-star text-warning me-2"></i>Featured Products</h2>
            </div>
            <a asp-controller="Shop" asp-action="Index" asp-route-IsFeatured="true" class="btn btn-light border rounded-pill btn-sm d-inline-flex align-items-center px-3 fw-bold shadow-sm hover-bg-light">
                View All <i class="fas fa-arrow-right ms-2"></i>
            </a>
        </div>

        <div class="row g-4">
            @if (Model.FeaturedProducts?.Any() == true)
            {
                @foreach (var product in Model.FeaturedProducts.Take(8))
                {
                    <div class="col-12 col-sm-6 col-md-4 col-xl-3">
                        <partial name="_ProductCard" model="product" view-data='new ViewDataDictionary(ViewData) { { "ImageClass", "product-card-image product-card-image--large" } }' />
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="text-center py-5 bg-light rounded-4 text-muted border border-dashed rounded-4">
                        <div class="d-inline-flex justify-content-center align-items-center bg-white rounded-circle shadow-sm mb-3" style="width: 80px; height: 80px;">
                            <i class="fas fa-star fa-2x text-warning" style="opacity: 0.5;"></i>
                        </div>
                        <p class="mb-0 fs-5 fw-medium">Featured products are currently unavailable.</p>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- Best Sellers -->
    <section class="mb-5 mt-5">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div class="d-flex align-items-center">
                <h2 class="h3 fw-bold mb-0 text-dark"><i class="fas fa-fire text-danger me-2"></i>Best Sellers</h2>
            </div>
            <a asp-controller="Shop" asp-action="Index" class="btn btn-light border rounded-pill btn-sm d-inline-flex align-items-center px-3 fw-bold shadow-sm hover-bg-light">
                View All <i class="fas fa-arrow-right ms-2"></i>
            </a>
        </div>

        <div class="row g-4">
            @if (Model.BestSellers?.Any() == true)
            {
                @foreach (var product in Model.BestSellers.Take(8))
                {
                    <div class="col-12 col-sm-6 col-md-4 col-xl-3">
                        <partial name="_ProductCard" model="product" view-data='new ViewDataDictionary(ViewData) { { "ImageClass", "product-card-image" } }' />
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="text-center py-5 bg-light rounded-4 text-muted border border-dashed rounded-4">
                        <div class="d-inline-flex justify-content-center align-items-center bg-white rounded-circle shadow-sm mb-3" style="width: 80px; height: 80px;">
                            <i class="fas fa-box-open fa-2x text-secondary" style="opacity: 0.5;"></i>
                        </div>
                        <p class="mb-0 fs-5 fw-medium">Check back later for our best-selling items.</p>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- Newsletter Signup -->
    <section class="mb-5 mt-5">
        <div class="card bg-dark text-white border-0 rounded-4 shadow-lg overflow-hidden position-relative p-4 p-md-5">
            <!-- Decorative background element -->
            <div class="position-absolute top-0 end-0 opacity-10" style="transform: translate(20%, -20%); background: radial-gradient(circle, #fff 0%, transparent 70%); width: 300px; height: 300px; border-radius: 50%;"></div>

            <div class="row align-items-center position-relative z-index-1">
                <div class="col-lg-6 mb-4 mb-lg-0 text-center text-lg-start">
                    <h2 class="h2 fw-bold mb-2"><i class="fas fa-envelope-open-text text-primary me-2"></i>Stay Updated</h2>
                    <p class="text-light mb-0 fs-5 opacity-75">
                        Subscribe to our newsletter and be the first to know about new products, exclusive deals, and special offers.
                    </p>
                </div>
                <div class="col-lg-6">
                    <form class="row g-2 justify-content-center justify-content-lg-end" novalidate onsubmit="event.preventDefault(); Swal.fire('Subscribed!', 'Thank you for subscribing to our newsletter.', 'success');">
                        <div class="col-12 col-sm-8 text-center text-sm-start">
                            <input type="email" class="form-control form-control-lg rounded-pill border-0 shadow-none px-4" placeholder="Enter your email address" required />
                        </div>
                        <div class="col-12 col-sm-auto text-center text-sm-start">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill px-4 fw-bold shadow-sm w-100 hover-scale">Subscribe</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>
</div>

<style>
    .border-dashed {
        border-style: dashed !important;
        border-width: 2px !important;
        border-color: #dee2e6 !important;
    }
</style>

<script src="~/js/cart.js"></script>