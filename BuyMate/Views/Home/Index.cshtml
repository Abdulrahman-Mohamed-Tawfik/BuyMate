@using BuyMate.DTO.ViewModels.Shop
@model HomeViewModel
@{
    ViewData["Title"] = "Home";
    var requestToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}
<div class="container mb-5">
    <input type="hidden" id="__RequestVerificationToken" value="@requestToken" />

    <section class="text-white p-5 mb-5 text-center position-relative d-flex align-items-center justify-content-center" style="min-height: 420px; background-image: linear-gradient(rgba(0,0,0,0.45), rgba(0,0,0,0.45)), url('/images/o3.jpg'); background-size: cover; background-position: center; border-radius: 0.9375rem;">
        <div class="mx-auto position-relative" style="z-index: 2; max-width: 48rem;">
            <h1 class="display-4 fw-bold mb-3">Welcome to BUYMATE</h1>
            <p class="fs-5 mb-4 text-light">
                Discover amazing products at unbeatable prices
            </p>
            <a asp-controller="Shop"
               asp-action="Index"
               class="btn btn-dark btn-lg d-inline-flex align-items-center">
                Shop Now
                <i class="fas fa-arrow-right ms-2"></i>
            </a>
        </div>
    </section>

    <!-- Featured Categories -->
    <section class="mb-5">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h2 class="h4 fw-bold mb-0">Shop by Category</h2>
            <a asp-controller="Shop" asp-action="Categories" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center">
                View All
                <i class="fas fa-arrow-right ms-2"></i>
            </a>
        </div>
        <div class="row g-4">
            @if (Model.Categories?.Any() == true)
            {
                @foreach (var category in Model.Categories.Take(8))
                {
                    <div class="col-6 col-md-3">
                        <partial name="_CategoryTile" model="category" />
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="text-center py-5 bg-light rounded-3 text-muted">
                        <i class="fas fa-folder-open fa-2x mb-2"></i>
                        <p class="mb-0">Categories will be available soon.</p>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- Featured Products -->
    <section class="mb-5">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div class="d-flex align-items-center">
                <i class="fas fa-star text-warning me-2"></i>
                <h2 class="h4 fw-bold mb-0">Featured Products</h2>
            </div>
            <a asp-controller="Shop" asp-action="Index" asp-route-IsFeatured="true" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center">
                View All
                <i class="fas fa-arrow-right ms-2"></i>
            </a>
        </div>

        <div class="row g-4">
            @if (Model.FeaturedProducts?.Any() == true)
            {
                @foreach (var product in Model.FeaturedProducts)
                {
                    <div class="col-12 col-sm-6 col-lg-4">
                        <partial name="_ProductCard" model="product" view-data='new ViewDataDictionary(ViewData) { { "ImageClass", "product-card-image product-card-image--large" } }' />
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="text-center py-5 bg-light rounded-3 text-muted">
                        <i class="fas fa-star fa-2x mb-2"></i>
                        <p class="mb-0">Featured products are currently unavailable. Please check back later.</p>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- Best Sellers -->
    <section class="mb-5">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div class="d-flex align-items-center">
                <i class="fas fa-chart-line text-success me-2"></i>
                <h2 class="h4 fw-bold mb-0">Best Sellers</h2>
            </div>
            <a asp-controller="Shop" asp-action="Index" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center">
                View All
                <i class="fas fa-arrow-right ms-2"></i>
            </a>
        </div>

        <div class="row g-4">
            @if (Model.BestSellers?.Any() == true)
            {
                @foreach (var product in Model.BestSellers)
                {
                    <div class="col-6 col-lg-2">
                        <partial name="_ProductCard" model="product" view-data='new ViewDataDictionary(ViewData) { { "ImageClass", "product-card-image" } }' />
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="text-center py-5 bg-light rounded-3 text-muted">
                        <i class="fas fa-box-open fa-2x mb-2"></i>
                        <p class="mb-0">Check back later for our best-selling items.</p>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- Newsletter Signup -->
    <section class="mb-5">
        <h2 class="h4 fw-bold mb-2">Stay Updated</h2>
        <p class="text-muted mb-3 mx-auto" style="max-width:32rem;">
            Subscribe to our newsletter and be the first to know about new products, exclusive deals, and special offers.
        </p>
        <form class="row g-2 justify-content-center" novalidate>
            <div class="col-12 col-sm-7 col-md-5">
                <input type="email" class="form-control" placeholder="Enter your email" />
            </div>
            <div class="col-12 col-sm-auto">
                <button type="submit" class="btn btn-dark w-100">Subscribe</button>
            </div>
        </form>
    </section>
</div>

<script src="~/js/cart.js"></script>
<script src="~/js/home.js"></script>