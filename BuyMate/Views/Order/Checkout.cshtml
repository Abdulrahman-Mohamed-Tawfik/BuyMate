@using BuyMate.DTO.ViewModels
@using BuyMate.DTO.ViewModels.Cart
@using BuyMate.DTO.ViewModels.Order
@model CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
}

<div class="container mb-5 mt-4" style="max-width: 64rem;">
    <div class="d-flex align-items-center mb-4">
        <h1 class="h3 fw-bold mb-0 text-dark">Checkout</h1>
    </div>

    <form asp-action="Create" asp-controller="Order" method="post" id="checkoutForm">
        <div class="row g-4">
            <div class="col-12 col-lg-7 d-flex flex-column gap-4">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="card-header bg-dark text-white p-3 px-4 d-flex align-items-center">
                        <h2 class="h5 mb-0 fw-semibold"><i class="fas fa-map-marker-alt me-2"></i>Shipping Information</h2>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label asp-for="ShippingAddress.Street" class="form-label small fw-bold text-uppercase text-secondary" style="letter-spacing: 0.5px;">Street Address</label>
                            <input asp-for="ShippingAddress.Street" class="form-control form-control-lg border-0 shadow-sm bg-light" placeholder="123 Main St, Apt 4B" />
                            <span asp-validation-for="ShippingAddress.Street" class="small text-danger"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-12 col-md-6">
                                <label asp-for="ShippingAddress.City" class="form-label small fw-bold text-uppercase text-secondary" style="letter-spacing: 0.5px;">City</label>
                                <input asp-for="ShippingAddress.City" class="form-control form-control-lg border-0 shadow-sm bg-light" placeholder="New York" />
                                <span asp-validation-for="ShippingAddress.City" class="small text-danger"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="ShippingAddress.State" class="form-label small fw-bold text-uppercase text-secondary" style="letter-spacing: 0.5px;">State/Province</label>
                                <input asp-for="ShippingAddress.State" class="form-control form-control-lg border-0 shadow-sm bg-light" placeholder="NY" />
                                <span asp-validation-for="ShippingAddress.State" class="small text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-1">
                            <label asp-for="ShippingAddress.ZipCode" class="form-label small fw-bold text-uppercase text-secondary" style="letter-spacing: 0.5px;">ZIP Code</label>
                            <input asp-for="ShippingAddress.ZipCode" class="form-control form-control-lg border-0 shadow-sm bg-light" placeholder="10001" />
                            <span asp-validation-for="ShippingAddress.ZipCode" class="small text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="card-header bg-dark text-white p-3 px-4 d-flex align-items-center">
                        <h2 class="h5 mb-0 fw-semibold"><i class="fas fa-credit-card me-2"></i>Payment Method</h2>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-12">
                                <input asp-for="PaymentMethod" type="radio" value="Card" id="pm-card" class="btn-check" checked />
                                <label class="btn btn-outline-dark w-100 text-start p-3 rounded-3 d-flex align-items-center" for="pm-card">
                                    <i class="fas fa-credit-card fs-4 me-3"></i>
                                    <div>
                                        <div class="fw-bold">Credit/Debit Card</div>
                                        <div class="small opacity-75">Pay securely with Visa, Mastercard, etc.</div>
                                    </div>
                                </label>
                            </div>
                            <div class="col-12">
                                <input asp-for="PaymentMethod" type="radio" value="Wallet" id="pm-wallet" class="btn-check" />
                                <label class="btn btn-outline-dark w-100 text-start p-3 rounded-3 d-flex align-items-center" for="pm-wallet">
                                    <i class="fab fa-apple-pay fs-4 me-3"></i>
                                    <div>
                                        <div class="fw-bold">Digital Wallet</div>
                                        <div class="small opacity-75">Apple Pay, Google Pay, PayPal</div>
                                    </div>
                                </label>
                            </div>
                            <div class="col-12">
                                <input asp-for="PaymentMethod" type="radio" value="Cod" id="pm-cod" class="btn-check" />
                                <label class="btn btn-outline-dark w-100 text-start p-3 rounded-3 d-flex align-items-center" for="pm-cod">
                                    <i class="fas fa-money-bill-wave fs-4 me-3"></i>
                                    <div>
                                        <div class="fw-bold">Cash on Delivery</div>
                                        <div class="small opacity-75">Pay when your order arrives</div>
                                    </div>
                                </label>
                            </div>
                        </div>
                        <span asp-validation-for="PaymentMethod" class="small text-danger d-block mt-2"></span>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="card-header bg-dark text-white p-3 px-4 d-flex align-items-center">
                        <h2 class="h5 mb-0 fw-semibold"><i class="fas fa-truck me-2"></i>Delivery Options</h2>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-12">
                                <input asp-for="DeliveryType" type="radio" value="Standard" id="dt-standard" class="btn-check delivery-option" data-fee="0" checked />
                                <label class="btn btn-outline-dark w-100 text-start p-3 rounded-3 d-flex align-items-center justify-content-between" for="dt-standard">
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-box fs-4 me-3"></i>
                                        <div>
                                            <div class="fw-bold">Standard Delivery</div>
                                            <div class="small opacity-75">5-7 business days</div>
                                        </div>
                                    </div>
                                    <span class="fw-bold">Free</span>
                                </label>
                            </div>
                            <div class="col-12">
                                <input asp-for="DeliveryType" type="radio" value="Express" id="dt-express" class="btn-check delivery-option" data-fee="9.99" />
                                <label class="btn btn-outline-dark w-100 text-start p-3 rounded-3 d-flex align-items-center justify-content-between" for="dt-express">
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-shipping-fast fs-4 me-3"></i>
                                        <div>
                                            <div class="fw-bold">Express Delivery</div>
                                            <div class="small opacity-75">2-3 business days</div>
                                        </div>
                                    </div>
                                    <span class="fw-bold">$9.99</span>
                                </label>
                            </div>
                            <div class="col-12">
                                <input asp-for="DeliveryType" type="radio" value="Scheduled" id="dt-scheduled" class="btn-check delivery-option" data-fee="4.99" />
                                <label class="btn btn-outline-dark w-100 text-start p-3 rounded-3 d-flex align-items-center justify-content-between" for="dt-scheduled">
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-calendar-check fs-4 me-3"></i>
                                        <div>
                                            <div class="fw-bold">Scheduled Delivery</div>
                                            <div class="small opacity-75">Pick a date</div>
                                        </div>
                                    </div>
                                    <span class="fw-bold">$4.99</span>
                                </label>
                            </div>
                        </div>
                        <span asp-validation-for="DeliveryType" class="small text-danger d-block mt-2"></span>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-5">
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden position-sticky" style="top: 2rem;">
                    <div class="card-header bg-primary text-white p-3 px-4 d-flex align-items-center">
                        <h2 class="h5 mb-0 fw-semibold"><i class="fas fa-receipt me-2"></i>Order Summary</h2>
                    </div>
                    <div class="card-body p-4 bg-light">
                        <div class="d-flex flex-column gap-3 mb-4 max-h-300 overflow-auto pe-2">
                            @foreach (var item in Model.CartVm.Items)
                            {
                                <div class="d-flex align-items-center gap-3 bg-white p-2 rounded-3 border">
                                    <div class="bg-light rounded-2 p-1 border d-flex align-items-center justify-content-center" style="width: 56px; height: 56px; flex-shrink: 0;">
                                        <img src="@((!string.IsNullOrEmpty(item.ImageUrl) ? (item.ImageUrl.StartsWith("/") ? item.ImageUrl : "/" + item.ImageUrl) : "/images/placeholder.png"))" alt="@item.ProductName" class="img-fluid" style="max-height: 100%; object-fit: contain;" />
                                    </div>
                                    <div class="flex-grow-1 min-vw-0">
                                        <div class="small fw-bold text-truncate" title="@item.ProductName">@item.ProductName</div>
                                        <div class="small text-muted d-flex justify-content-between mt-1">
                                            <span>Qty: @item.Quantity</span>
                                            <span class="fw-bold text-dark">@item.TotalPrice.ToString("C")</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="d-flex flex-column gap-2 mb-4 bg-white p-3 rounded-3 border">
                            <div class="d-flex justify-content-between text-secondary">
                                <span class="small fw-medium">Subtotal</span>
                                <span class="fw-medium text-dark" id="summarySubtotal" data-value="@Model.CartVm.Items.Sum(item => item.TotalPrice)">@Model.CartVm.Items.Sum(item => item.TotalPrice).ToString("C")</span>
                            </div>
                            <div class="d-flex justify-content-between text-secondary">
                                <span class="small fw-medium">Shipping Fee</span>
                                <span class="fw-medium text-dark" id="summaryShipping">$0.00</span>
                            </div>
                            <div class="d-flex justify-content-between text-secondary">
                                <span class="small fw-medium">Tax</span>
                                <span class="fw-medium text-dark">$0.00</span>
                            </div>
                            <hr class="my-2 border-light" />
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-bold text-uppercase" style="letter-spacing: 1px;">Total</span>
                                <span class="fs-3 fw-bold text-primary" id="summaryTotal">@Model.CartVm.Items.Sum(item => item.TotalPrice).ToString("C")</span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary d-block w-100 btn-lg rounded-pill fw-bold shadow-sm hover-lift">
                            <i class="fas fa-lock me-2"></i> Complete Place Order
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<style>
    .hover-lift { transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .hover-lift:hover { transform: translateY(-3px); box-shadow: 0 10px 20px rgba(0,0,0,0.15) !important; }
    .max-h-300 { max-height: 300px; }

    /* Scrollbar for items */
    .overflow-auto::-webkit-scrollbar { width: 6px; }
    .overflow-auto::-webkit-scrollbar-track { background: #f1f1f1; border-radius: 4px; }
    .overflow-auto::-webkit-scrollbar-thumb { background: #ccc; border-radius: 4px; }
    .overflow-auto::-webkit-scrollbar-thumb:hover { background: #b3b3b3; }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const deliveryOptions = document.querySelectorAll('.delivery-option');
            const shippingElem = document.getElementById('summaryShipping');
            const totalElem = document.getElementById('summaryTotal');
            const subtotalVal = parseFloat(document.getElementById('summarySubtotal').getAttribute('data-value'));

            function updateTotals() {
                let fee = 0;
                document.querySelectorAll('.delivery-option').forEach(opt => {
                    if (opt.checked) {
                        fee = parseFloat(opt.getAttribute('data-fee'));
                    }
                });

                shippingElem.textContent = fee === 0 ? "Free" : "$" + fee.toFixed(2);

                const formatTotal = (subtotalVal + fee).toLocaleString('en-US', {
                    style: 'currency',
                    currency: 'USD'
                });
                totalElem.textContent = formatTotal;
            }

            deliveryOptions.forEach(opt => {
                opt.addEventListener('change', updateTotals);
            });

            // Initial calculation
            updateTotals();
        });
    </script>
}
