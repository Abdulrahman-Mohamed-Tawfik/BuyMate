@using BuyMate.DTO.ViewModels.Order
@model List<OrderViewModel>
@{
    ViewData["Title"] = "My Orders";
}

<div class="container mb-5 mt-4" style="max-width: 54rem;">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 fw-bold mb-0 text-dark"><i class="fas fa-box-open text-primary me-2"></i>My Orders</h1>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var order in Model)
            {
                <div class="card p-3 rounded-4 shadow-sm border-0 hover-lift transition-all" style="transition: transform 0.2s ease;">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-2 border-bottom pb-2">
                        <div class="mb-2 mb-md-0">
                            <h3 class="h6 fw-bold mb-1 text-dark">Order #@order.TrackingNumber</h3>
                            <p class="small text-muted mb-0"><i class="far fa-calendar-alt me-1"></i> Placed on @order.OrderDate.ToString("MMM dd, yyyy")</p>
                        </div>
                        <div class="text-md-end">
                            <p class="fs-6 fw-bold text-dark mb-1">@order.Total.ToString("C")</p>
                            <span class="badge rounded-pill px-2 py-1 fw-medium shadow-sm @(
                                order.Status == OrderStatusViewModel.Delivered ? "bg-success text-white" :
                                order.Status == OrderStatusViewModel.Shipped ? "bg-primary text-white" :
                                order.Status == OrderStatusViewModel.Cancelled ? "bg-danger text-white" : "bg-warning text-dark")">
                                <i class="fas @(
                                    order.Status == OrderStatusViewModel.Delivered ? "fa-check-circle" :
                                    order.Status == OrderStatusViewModel.Shipped ? "fa-truck" :
                                    order.Status == OrderStatusViewModel.Cancelled ? "fa-times-circle" : "fa-clock"
                                ) me-1"></i>
                                @order.Status
                            </span>
                        </div>
                    </div>

                    <div class="d-flex flex-column gap-2 mb-2">
                        @foreach (var item in order.Items)
                        {
                            <div class="d-flex align-items-center gap-2 bg-light p-2 rounded-3 border">
                                <div class="bg-white rounded-2 p-1 border shadow-sm d-flex align-items-center justify-content-center" style="width: 56px; height: 56px; flex-shrink: 0;">
                                    <img src="@((!string.IsNullOrEmpty(item.ImageUrl) ? (item.ImageUrl.StartsWith("/") ? item.ImageUrl : "/" + item.ImageUrl) : "/images/placeholder.png"))" alt="@item.ProductName" class="img-fluid" style="max-height: 100%; object-fit: contain;" />
                                </div>
                                <div class="flex-grow-1 min-vw-0">
                                    <h4 class="small fw-semibold mb-0 text-truncate" title="@item.ProductName">@item.ProductName</h4>
                                    <p class="small text-muted mb-0">Qty: @item.Quantity</p>
                                </div>
                                <span class="small fw-bold text-dark me-2 pe-2 border-end d-none d-sm-block">@item.TotalPrice.ToString("C")</span>
                            </div>
                        }
                    </div>

                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center bg-light rounded-3 p-2 px-3 mt-1">
                        <div class="small fw-medium text-secondary mb-2 mb-sm-0 d-flex align-items-center">
                            @if (order.EstimatedDelivery.HasValue)
                            {
                                <i class="fas fa-shipping-fast text-primary me-2"></i>
                                <span>Est. delivery: <span class="text-dark">@order.EstimatedDelivery.Value.ToString("MMM dd, yyyy")</span></span>
                            }
                        </div>
                        <a asp-controller="Order" asp-action="Get" asp-route-orderid="@order.Id" class="btn btn-outline-dark btn-sm rounded-pill px-3 fw-bold shadow-sm hover-scale hover-bg-dark">
                            View Details
                        </a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5 bg-light rounded-4 text-muted border border-dashed p-4 p-md-5 my-2 shadow-sm">
            <div class="d-inline-flex justify-content-center align-items-center bg-white rounded-circle shadow-sm mb-4" style="width: 100px; height: 100px;">
                <i class="fas fa-box-open fa-3x text-secondary" style="opacity: 0.5;"></i>
            </div>
            <h2 class="h4 fw-bold mb-2 text-dark">No orders yet</h2>
            <p class="text-muted fs-5 mb-4 max-w-md mx-auto" style="max-width: 400px;">When you place your first order, it will appear here. Start exploring our products!</p>
            <a asp-controller="Shop" asp-action="Index" class="btn btn-dark btn-lg rounded-pill px-5 fw-bold shadow-sm hover-lift">
                <i class="fas fa-shopping-bag me-2"></i> Start Shopping
            </a>
        </div>
    }
</div>

<style>
    .hover-lift:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important; }
    .transition-all { transition: all 0.3s ease; }
    .border-dashed { border-style: dashed !important; border-width: 2px !important; border-color: #dee2e6 !important; }
    .hover-scale:hover { transform: scale(1.05); }
</style>