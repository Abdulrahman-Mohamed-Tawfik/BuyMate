@using BuyMate.DTO.ViewModels.Product
@model List<ProductViewModel>
@{
    ViewData["Title"] = "Products";
}

<div class="container mb-5" style="max-width: 80rem;">
    <div class="d-flex align-items-center mb-4 mt-4">
        <a asp-controller="Admin" asp-action="Index" class="btn btn-light rounded-circle shadow-sm border p-0 d-flex align-items-center justify-content-center me-3 hover-lift" style="width: 40px; height: 40px; transition: transform 0.2s;">
            <i class="fas fa-arrow-left text-dark"></i>
        </a>
        <div>
            <h1 class="h3 fw-bold mb-0">Products Management</h1>
            <p class="text-muted small mb-0">Manage your product catalog, pricing, and inventory.</p>
        </div>
        <div class="ms-auto">
            <a asp-controller="Product" asp-action="Create" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm hover-lift d-inline-flex align-items-center">
                <i class="fas fa-plus me-2"></i> Add New Product
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-dark text-white p-3 px-4 d-flex align-items-center">
            <h2 class="h6 mb-0 fw-semibold"><i class="fas fa-box-open me-2"></i>Product Catalog</h2>
        </div>
        <div class="table-responsive mb-0 p-0">
            <table class="table table-hover align-middle mb-0 border-0">
                <thead class="table-light border-bottom">
                    <tr>
                        <th scope="col" class="py-3 px-4 fw-semibold text-uppercase text-secondary small" style="letter-spacing: 0.5px;">Product</th>
                        <th scope="col" class="py-3 fw-semibold text-uppercase text-secondary small" style="letter-spacing: 0.5px;">Brand</th>
                        <th scope="col" class="py-3 fw-semibold text-uppercase text-secondary small" style="letter-spacing: 0.5px;">Price</th>
                        <th scope="col" class="py-3 fw-semibold text-uppercase text-secondary small" style="letter-spacing: 0.5px;">Stock</th>
                        <th scope="col" class="py-3 fw-semibold text-uppercase text-secondary small text-center" style="letter-spacing: 0.5px;">Status</th>
                        <th scope="col" class="py-3 fw-semibold text-uppercase text-secondary small text-end px-4" style="letter-spacing: 0.5px;">Actions</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @if (Model != null && Model.Count != 0)
                    {
                        foreach (var product in Model)
                        {
                            <tr class="align-middle">
                                <td class="px-4 py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-light rounded-3 p-1 border d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                                            @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                            {
                                                <img src="@(product.ImageUrl.StartsWith("/") ? product.ImageUrl : "/images/" + product.ImageUrl)" alt="@product.Name" class="img-fluid rounded-2" style="max-height: 100%; max-width: 100%; object-fit: contain;" />
                                            }
                                            else
                                            {
                                                <i class="fas fa-image text-muted fs-4"></i>
                                            }
                                        </div>
                                        <div>
                                            <h6 class="mb-1 fw-bold text-dark">
                                                <a asp-controller="Shop" asp-action="Product" asp-route-id="@product.Id" class="text-decoration-none text-dark hover-primary" target="_blank">@product.Name</a>
                                            </h6>
                                            <div class="small text-muted d-flex align-items-center gap-2">
                                                <span class="text-warning"><i class="fas fa-star me-1"></i>@(product.Rating > 0 ? product.Rating.ToString("F1") : "N/A")</span>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(product.Brand))
                                    {
                                        <span class="badge border border-secondary text-secondary rounded-pill px-2 py-1 fw-normal">@product.Brand</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@product.Price.ToString("C")</div>
                                    @if (product.Discount.HasValue && product.Discount > 0)
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-2 py-0 fw-semibold small">@product.Discount% OFF</span>
                                    }
                                </td>
                                <td>
                                    @if (product.StockQuantity > 10)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2 py-1 fw-semibold"><i class="fas fa-check-circle me-1"></i> @product.StockQuantity In Stock</span>
                                    }
                                    else if (product.StockQuantity > 0)
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-2 py-1 fw-semibold"><i class="fas fa-exclamation-triangle me-1"></i> Only @product.StockQuantity Left</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-2 py-1 fw-semibold"><i class="fas fa-times-circle me-1"></i> Out of Stock</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-flex flex-column gap-1 align-items-center">
                                        @if (product.IsFeatured)
                                        {
                                            <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 rounded-pill fw-semibold" style="width: 85px;"><i class="fas fa-star me-1"></i> Featured</span>
                                        }
                                        @if (product.IsFlashDeal)
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill fw-semibold" style="width: 85px;"><i class="fas fa-bolt me-1"></i> Flash</span>
                                        }
                                        @if (!product.IsFeatured && !product.IsFlashDeal)
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </div>
                                </td>
                                <td class="px-4 text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-controller="Product" asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-light border shadow-sm text-secondary hover-lift rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form action="@Url.Action("Delete", "Product", new { id = product.Id })" method="post" class="swal-delete d-inline" data-confirm="Delete @product.Name?">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-light border shadow-sm text-danger hover-lift rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" title="Delete">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="d-flex flex-column align-items-center justify-content-center">
                                    <div class="bg-light rounded-circle d-flex align-items-center justify-content-center mb-3 text-muted" style="width: 80px; height: 80px;">
                                        <i class="fas fa-box-open fa-2x"></i>
                                    </div>
                                    <h4 class="h5 fw-bold text-dark mb-1">No Products Found</h4>
                                    <p class="text-muted mb-3">You haven't added any products to your catalog yet.</p>
                                    <a asp-controller="Product" asp-action="Create" class="btn btn-outline-primary rounded-pill px-4">
                                        <i class="fas fa-plus me-1"></i> Add Your First Product
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .hover-lift { transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .hover-lift:hover { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(0,0,0,0.08) !important; }
    .hover-primary:hover { color: var(--bs-primary) !important; }
</style>

@section Scripts {
    <script src="~/js/product-index.js"></script>
}