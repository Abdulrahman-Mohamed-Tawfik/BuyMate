<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BUYMATE</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="icon" type="image/png" href="~/images/buymate-icon.webp" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-..." crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="bg-background text-foreground d-flex flex-column min-vh-100">
    <header class="sticky-top" style="z-index: 1030;">
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm py-2 py-md-3">
            <div class="container">
                <button class="btn border-0 px-2 me-2 shadow-none text-dark fs-5" type="button" data-bs-toggle="offcanvas" data-bs-target="#mainSidePanel" aria-controls="mainSidePanel" aria-label="Open menu">
                    <i class="fas fa-bars"></i>
                </button>

                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index" aria-label="Go to homepage">
                    <img src="~/images/buymate-logo.webp" alt="BUYMATE" class="me-2" style="height:42px; width:auto;" />
                </a>

                <form class="d-none d-lg-flex flex-grow-1 mx-4" style="max-width: 600px;" asp-controller="Shop" asp-action="Index" method="get">
                    <div class="input-group input-group-lg shadow-sm rounded-pill overflow-hidden border">
                        <span class="input-group-text bg-light border-0 ps-4 text-muted"><i class="fas fa-search"></i></span>
                        <input name="Search" type="text" class="form-control bg-light border-0 ps-2 fs-6" placeholder="Search for premium products..." aria-label="Search products" style="box-shadow: none !important; outline: none;" />
                        <button type="submit" class="btn btn-dark px-4 fw-bold" style="box-shadow: none !important;">Search</button>
                    </div>
                </form>

                <div class="d-flex align-items-center gap-2 gap-md-3 ms-auto">
                    <a asp-controller="Wishlist" asp-action="Index" class="btn btn-light rounded-circle shadow-sm position-relative d-flex align-items-center justify-content-center p-0 border" style="width: 45px; height: 45px;" aria-label="Wishlist">
                        <i class="far fa-heart fs-5 text-secondary"></i>
                        <span class="wishlist-badge badge bg-danger position-absolute top-0 start-100 translate-middle rounded-pill border border-2 border-white" style="display:none; font-size: 0.65rem;">0</span>
                    </a>

                    <div class="position-relative">
                        <vc:cart-summary />
                    </div>

                    <div class="vr d-none d-md-block mx-1" style="height: 30px; align-self: center;"></div>

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <div class="dropdown">
                            <a class="btn btn-light rounded-pill border shadow-sm dropdown-toggle d-flex align-items-center pe-3 ps-1 py-1" href="#" role="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false" style="transition: all 0.2s;">
                                <vc:user-avatar></vc:user-avatar>
                                <span class="d-none d-sm-inline fw-semibold text-dark">@User.Identity.Name</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg rounded-4 mt-2" aria-labelledby="userMenu">
                                @if (User.IsInRole("admin"))
                                {
                                    <li>
                                        <a class="dropdown-item py-2 fw-medium text-primary d-flex align-items-center" asp-controller="Admin" asp-action="Index">
                                            <i class="fas fa-gauge me-2" style="width: 20px; text-align: center;"></i> Admin Dashboard
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider opacity-10"></li>
                                }
                                <li>
                                    <a class="dropdown-item py-2 fw-medium text-dark d-flex align-items-center" asp-controller="User" asp-action="Profile">
                                        <i class="far fa-id-badge me-2" style="width: 20px; text-align: center;"></i> Profile
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2 fw-medium text-dark d-flex align-items-center" asp-controller="Order" asp-action="Index">
                                        <i class="fas fa-box-open me-2" style="width: 20px; text-align: center;"></i> Orders
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider opacity-10" /></li>
                                <li>
                                    <form asp-controller="User" asp-action="Logout" method="post" class="px-2">
                                        <button type="submit" class="dropdown-item py-2 fw-bold text-danger rounded-3 d-flex align-items-center">
                                            <i class="fas fa-sign-out-alt me-2" style="width: 20px; text-align: center;"></i> Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-2">
                            <a asp-controller="User" asp-action="Login" class="btn btn-outline-dark rounded-pill px-3 fw-bold d-none d-sm-inline-flex align-items-center" aria-label="Login">
                                <i class="far fa-user me-2"></i>Login
                            </a>
                            <a asp-controller="User" asp-action="Register" class="btn btn-dark rounded-pill px-4 fw-bold d-none d-sm-inline-flex align-items-center shadow-sm" aria-label="Register">
                                Register
                            </a>

                            <!-- Mobile Auth Icons -->
                            <a asp-controller="User" asp-action="Login" class="btn btn-light rounded-circle shadow-sm border d-sm-none d-flex align-items-center justify-content-center p-0" style="width: 45px; height: 45px;" aria-label="Login">
                                <i class="far fa-user fs-5 text-dark"></i>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </nav>

        <div class="offcanvas offcanvas-start shadow" tabindex="-1" id="mainSidePanel" aria-labelledby="mainSidePanelLabel" data-bs-scroll="true">
            <div class="offcanvas-header border-bottom bg-white py-3">
                <div class="d-flex align-items-center gap-2">
                    <img src="~/images/buymate-icon.webp" alt="BUYMATE" style="width:32px;height:32px;object-fit:contain;" />
                    <div class="lh-sm">
                        <div class="fw-bold fs-5 text-dark" id="mainSidePanelLabel">BUYMATE</div>
                    </div>
                </div>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body p-0 bg-light">
                <div class="p-3">
                    <div class="small text-uppercase text-secondary fw-bold mb-3 ms-2" style="letter-spacing: 1px;">Discover</div>
                    <div class="list-group list-group-flush gap-1">
                        <a class="list-group-item list-group-item-action d-flex align-items-center gap-3 rounded-3 border-0 py-3 fw-medium" asp-controller="Shop" asp-action="Index">
                            <div class="bg-white rounded-circle shadow-sm d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                <i class="fas fa-store text-dark"></i>
                            </div>
                            <span>Shop All Products</span>
                        </a>
                        <a class="list-group-item list-group-item-action d-flex align-items-center gap-3 rounded-3 border-0 py-3 fw-medium text-danger" asp-controller="Shop" asp-action="Deals">
                            <div class="bg-danger bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                <i class="fas fa-bolt"></i>
                            </div>
                            <span>Flash Deals</span>
                        </a>

                        @if (User.IsInRole("admin"))
                        {
                            <div class="border-top my-3 border-secondary border-opacity-25"></div>
                            <div class="small text-uppercase text-secondary fw-bold mb-3 ms-2" style="letter-spacing: 1px;">Administration</div>
                            <a class="list-group-item list-group-item-action d-flex align-items-center gap-3 rounded-3 border-0 py-3 fw-medium" asp-controller="Admin" asp-action="Index">
                                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                    <i class="fas fa-gauge"></i>
                                </div>
                                <span>Admin Dashboard</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="bg-white border-bottom shadow-sm d-lg-none">
            <div class="container py-3">
                <form asp-controller="Shop" asp-action="Index" method="get">
                    <div class="input-group input-group-lg shadow-sm rounded-pill overflow-hidden border">
                        <input type="text" name="Search" class="form-control border-0 bg-light fs-6 ps-4" placeholder="Search products..." style="box-shadow: none !important; outline: none;" />
                        <button type="submit" class="btn btn-dark px-3" aria-label="Search" style="box-shadow: none !important;">
                            <i class="fas fa-magnifying-glass text-white"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </header>

    <main class="flex-grow-1 container my-4">
        @if (TempData["Success"] != null)
        {
            <div id="successAlert" class="alert alert-success bg-white border-0 border-start border-5 border-success shadow-sm rounded-4 position-relative mx-auto overflow-hidden d-flex align-items-center p-3 mb-4" style="max-width: 500px;" role="alert">
                <div class="bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; flex-shrink: 0;">
                    <i class="fas fa-check fs-5"></i>
                </div>
                <div class="flex-grow-1">
                    <span class="d-block fw-bold text-dark">Success</span>
                    <span class="d-block text-secondary small fw-medium mt-1">@TempData["Success"]</span>
                </div>
                <button type="button" class="btn-close shadow-none ms-2" data-bs-dismiss="alert" aria-label="Close"></button>
                <div id="progressBar" class="position-absolute bottom-0 start-0 bg-success" style="height:4px;width:0%; transition: width 0.1s linear;"></div>
            </div>
        }

        @if (TempData["Error"] != null || ViewData.ModelState.ErrorCount > 0)
        {
            <div id="errorAlert" class="alert alert-danger bg-white border-0 border-start border-5 border-danger shadow-sm rounded-4 position-relative mx-auto overflow-hidden d-flex align-items-center p-3 mb-4" style="max-width: 500px;" role="alert">
                <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; flex-shrink: 0;">
                    <i class="fas fa-exclamation-triangle fs-5"></i>
                </div>
                <div class="flex-grow-1">
                    <span class="d-block fw-bold text-dark mb-1">Error</span>
                    @if (ViewData.ModelState.ErrorCount > 0)
                    {
                        <ul class="mb-0 ps-3 text-secondary small fw-medium">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <span class="d-block text-secondary small fw-medium">@TempData["Error"]</span>
                    }
                </div>
                <button type="button" class="btn-close shadow-none ms-2" data-bs-dismiss="alert" aria-label="Close"></button>
                <div id="errorProgressBar" class="position-absolute bottom-0 start-0 bg-danger" style="height:4px;width:0%; transition: width 0.1s linear;"></div>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="border-top mt-5 bg-light text-dark">
        <div class="container py-4">
            <div class="row g-4">
                <div class="col-12 col-md-3">
                    <h5 class="fw-semibold mb-3">BUYMATE</h5>
                    <p class="small text-muted mb-0">
                        Your trusted e-commerce platform for quality products at great prices.
                    </p>
                </div>

                <div class="col-6 col-md-3">
                    <h6 class="fw-medium mb-3">Quick Links</h6>
                    <ul class="list-unstyled small mb-0">
                        <li><a asp-controller="Home" asp-action="Index" class="text-muted text-decoration-none">Home</a></li>
                        <li><a asp-controller="Shop" asp-action="Index" class="text-muted text-decoration-none">Shop</a></li>
                        <li><a asp-controller="Shop" asp-action="Deals" class="text-muted text-decoration-none">Deals</a></li>
                        <li><a asp-controller="Home" asp-action="About" class="text-muted text-decoration-none">About</a></li>
                        <li><a asp-controller="Home" asp-action="Terms" class="text-muted text-decoration-none">Terms</a></li>
                    </ul>
                </div>

                <div class="col-6 col-md-3">
                    <h6 class="fw-medium mb-3">Support</h6>
                    <ul class="list-unstyled small mb-0">
                        <li><a asp-controller="Home" asp-action="Support" class="text-muted text-decoration-none">Help Center</a></li>
                        <li><a asp-controller="Home" asp-action="Contact" class="text-muted text-decoration-none">Contact Us</a></li>
                        <li><a asp-controller="Home" asp-action="Cookies" class="text-muted text-decoration-none">Cookies</a></li>
                        <li><a asp-controller="Home" asp-action="FAQ" class="text-muted text-decoration-none">FAQ</a></li>
                    </ul>
                </div>

                <div class="col-12 col-md-3">
                    <h6 class="fw-medium mb-3">Legal</h6>
                    <ul class="list-unstyled small mb-0">
                        <li><a asp-controller="Home" asp-action="Privacy" class="text-muted text-decoration-none">Privacy Policy</a></li>
                        <li><a asp-controller="Home" asp-action="Terms" class="text-muted text-decoration-none">Terms of Service</a></li>
                        <li><a asp-controller="Home" asp-action="Returns" class="text-muted text-decoration-none">Returns</a></li>
                    </ul>
                </div>
            </div>

            <div class="border-top mt-4 pt-3 text-center small text-muted">
                &copy; 2024 BUYMATE. All rights reserved.
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>