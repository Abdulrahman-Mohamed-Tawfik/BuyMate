@using BuyMate.DTO.ViewModels.Shop
@model ShopViewModel
@{
    var totalPages = (int)Math.Ceiling((double)Model.TotalCount / (Model.PageSize > 0 ? Model.PageSize : 1));
    var prev = Model.PageNumber - 1;
    var next = Model.PageNumber + 1;

    var routeData = new Dictionary<string, string>
    {
        { "search", Model.Search },
        { "brand", Model.SelectedBrand },
        { "minPrice", Model.SelectedMinPrice?.ToString() },
        { "maxPrice", Model.SelectedMaxPrice?.ToString() },
        { "hasDiscount", Model.HasDiscount.HasValue ? Model.HasDiscount.ToString() : null },
        { "isFeatured", Model.IsFeatured.HasValue ? Model.IsFeatured.ToString() : null },
        { "orderBy", Model.OrderBy },
        { "asc", Model.Asc.ToString() },
        { "categoryId", Model.SelectedCategoryId?.ToString() }
    };
}

<nav aria-label="Product pagination" class="mt-5 d-flex flex-column align-items-center">
    <ul class="pagination pagination-lg border-0 gap-3 mb-2">
        <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
            <a class="page-link rounded-circle border-0 shadow-sm text-dark d-flex align-items-center justify-content-center hover-scale" 
               style="width: 50px; height: 50px; transition: all 0.2s;"
               asp-controller="Shop" asp-action="Index"
               asp-all-route-data="routeData" asp-route-pageNumber="@Math.Max(1, prev)"
               aria-label="Previous page">
               <i class="fas fa-chevron-left fs-5"></i>
            </a>
        </li>

        <li class="page-item active" aria-current="page">
            <span class="page-link rounded-circle border-0 bg-dark text-white shadow d-flex align-items-center justify-content-center fw-bold fs-5" 
                  style="width: 50px; height: 50px;">
                @Model.PageNumber
            </span>
        </li>

        <li class="page-item @(Model.PageNumber >= totalPages ? "disabled" : "")">
            <a class="page-link rounded-circle border-0 shadow-sm text-dark d-flex align-items-center justify-content-center hover-scale" 
               style="width: 50px; height: 50px; transition: all 0.2s;"
               asp-controller="Shop" asp-action="Index"
               asp-all-route-data="routeData" asp-route-pageNumber="@(next <= totalPages ? next : totalPages)"
               aria-label="Next page">
               <i class="fas fa-chevron-right fs-5"></i>
            </a>
        </li>
    </ul>
    <div class="text-muted small fw-medium mt-1">
        Page @Model.PageNumber of @(totalPages > 0 ? totalPages : 1)
    </div>
</nav>

<style>
    .page-item.disabled .page-link {
        opacity: 0.5;
        background-color: #f8f9fa !important;
        pointer-events: none;
    }
    .page-link.hover-scale:hover {
        transform: scale(1.1);
        background-color: #212529 !important;
        color: #fff !important;
    }
    .page-link {
        cursor: pointer;
    }
</style>
