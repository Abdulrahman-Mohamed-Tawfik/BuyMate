@using BuyMate.DTO.ViewModels.Product
@model ProductViewModel
@{
    var imageClass = ViewData["ImageClass"]?.ToString() ?? "product-card-image";
}

<div class="card h-100 border-0 shadow-sm rounded-4 position-relative overflow-hidden product-card-modern" style="transition: all 0.3s ease;">
    <!-- Image Wrapper with subtle background -->
    <div class="position-relative text-center p-4 bg-light d-flex align-items-center justify-content-center" style="height: 220px;">
        <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/placeholder.png" : (Model.ImageUrl.StartsWith("/") ? Model.ImageUrl : "/images/" + Model.ImageUrl))" alt="@Model.Name" class="@imageClass img-fluid hover-zoom" style="max-height: 160px; object-fit: contain; transition: transform 0.4s ease;" />

        @if (Model.IsFlashDeal)
        {
            <span class="badge bg-danger position-absolute top-0 start-0 m-3 px-2 py-1 rounded-pill fw-medium"><i class="fas fa-bolt me-1"></i>Flash Deal</span>
        }
        @if (Model.Discount.HasValue && Model.Discount > 0)
        {
            <span class="badge bg-dark position-absolute top-0 end-0 m-3 px-2 py-1 rounded-pill fw-bold">-@Model.Discount%</span>
        }

        <!-- Wishlist floating button -->
        <button class="btn btn-light text-secondary rounded-circle shadow-sm position-absolute bottom-0 end-0 m-2 p-0 d-flex align-items-center justify-content-center border" style="width: 36px; height: 36px; z-index: 3;" aria-label="Add to Wishlist">
            <i class="far fa-heart"></i>
        </button>
    </div>

    <div class="card-body p-4 d-flex flex-column bg-white">
        <div class="mb-3">
            @if(!string.IsNullOrEmpty(Model.Brand)) {
                <span class="text-uppercase small fw-bold text-primary mb-1 d-block" style="font-size: 0.70rem; letter-spacing: 1px;">@Model.Brand</span>
            }
            <h3 class="h6 fw-bold mb-2 text-truncate" title="@Model.Name" style="line-height: 1.4;">
                <a asp-controller="Shop" asp-action="Product" asp-route-id="@Model.Id" class="text-dark text-decoration-none stretched-link">@Model.Name</a>
            </h3>

            <div class="d-flex align-items-center mb-1">
                <partial name="_StarRating" model="((double)Model.Rating, Model.ReviewCount)" />
            </div>
        </div>

        <div class="mt-auto position-relative" style="z-index: 2;">
            <div class="d-flex align-items-baseline mb-3 flex-wrap">
                <span class="fw-bold text-dark fs-5 mb-0">@Model.Price.ToString("C")</span>
                @if (Model.OriginalPrice.HasValue && Model.OriginalPrice > Model.Price)
                {
                    <span class="small text-muted text-decoration-line-through ms-2 fw-medium">@Model.OriginalPrice.Value.ToString("C")</span>
                }
            </div>

            <button class="btn btn-outline-dark w-100 rounded-pill fw-bold hover-bg-dark" style="transition: all 0.2s;" onclick="addToCart('@Model.Id', event)">
                <i class="fas fa-cart-plus me-2"></i>Add to Cart
            </button>
        </div>
    </div>
</div>

<style>
.product-card-modern:hover {
    transform: translateY(-6px);
    box-shadow: 0 15px 30px rgba(0,0,0,0.08) !important;
}
.product-card-modern:hover .hover-zoom {
    transform: scale(1.08);
}
.hover-bg-dark:hover {
    background-color: #212529 !important;
    color: white !important;
}
</style>
