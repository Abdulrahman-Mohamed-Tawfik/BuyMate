@using BuyMate.DTO.ViewModels.Product
@model List<ProductViewModel>
@{
    ViewData["Title"] = "Flash Deals";
}

<div class="container mb-5 mt-4" style="max-width: 80rem;">
    <div class="text-center mb-5 position-relative">
        <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-2 mb-3 fw-semibold" style="letter-spacing: 1px;"><i class="fas fa-bolt me-2"></i>LIMITED TIME</span>
        <h1 class="display-4 fw-bolder mb-3 text-dark" style="letter-spacing: -1px;">Flash Deals</h1>
        <p class="text-secondary fs-5 mx-auto" style="max-width: 600px;">Incredible limited-time offers you don't want to miss. Grab them before they're gone!</p>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var product in Model)
            {
                <div class="col-12 col-sm-6 col-md-4 col-xl-3 hover-lift">
                    <partial name="_ProductCard" model="product" view-data='new ViewDataDictionary(ViewData) { { "ImageClass", "product-card-image product-card-image--large" } }' />
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5 bg-light rounded-5 border border-dashed mt-4 mx-auto" style="border-width: 2px !important; border-color: #dee2e6 !important; max-width: 50rem;">
            <div class="d-inline-flex justify-content-center align-items-center bg-white rounded-circle shadow-sm mb-4" style="width: 100px; height: 100px;">
                <i class="fas fa-history fa-3x text-muted" style="opacity: 0.5;"></i>
            </div>
            <h3 class="h4 fw-bold mb-3 text-dark">No flash deals right now</h3>
            <p class="text-muted fs-5 mb-4 max-w-md mx-auto" style="max-width: 400px;">Our flash deals have ended. Check back later for more amazing offers!</p>
            <a asp-controller="Shop" asp-action="Index" class="btn btn-dark btn-lg rounded-pill px-5 fw-bold shadow-sm hover-lift"><i class="fas fa-store me-2"></i>Continue Shopping</a>
        </div>
    }
</div>
<style>
    .border-dashed {
        border-style: dashed !important;
    }
</style>

<script src="~/js/shop-deals.js"></script>
