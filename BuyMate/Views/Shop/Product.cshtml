@using BuyMate.DTO.ViewModels.Product
@model ProductViewModel
@{
    ViewData["Title"] = Model.Name;

    string ResolveImage(string? img)
    {
        if (string.IsNullOrWhiteSpace(img))
        {
            return Url.Content("~/images/placeholder.png");
        }
        if (img.StartsWith("http", StringComparison.OrdinalIgnoreCase))
        {
            return img!;
        }
        if (img.StartsWith("~"))
        {
            return Url.Content(img);
        }
        return Url.Content($"~/images/{img}");
    }
}

<div class="container mb-5" style="max-width: 80rem;">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Home</a></li>
            <li class="breadcrumb-item"><a href="/Shop" class="text-decoration-none text-muted">Shop</a></li>
            <li class="breadcrumb-item active fw-medium" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="row g-5">
        <section class="col-12 col-md-6 col-lg-6 position-relative" aria-labelledby="product-image-gallery">
            <div class="d-flex gap-2">
                @if (Model.ImageUrls != null && Model.ImageUrls.Count > 0)
                {
                    <div id="thumbnails" class="d-flex flex-column gap-1 overflow-x-hidden overflow-y-auto pe-1" style="width: 60px; max-height: 500px; scrollbar-width: thin;">
                        @for (int i = 0; i < Math.Min(8, Model.ImageUrls.Count); i++)
                        {
                            var thumbSrc = ResolveImage(Model.ImageUrls[i]);
                            <button type="button" class="btn p-0 border rounded-3 bg-white flex-shrink-0" style="width: 60px; height: 60px; overflow:hidden;" onclick="window.setMainImage('@thumbSrc', @i)" aria-label="View image">
                                <img src="@thumbSrc" alt="@Model.Name thumbnail" class="w-100 h-100 p-1" style="object-fit:contain;" />
                            </button>
                        }
                    </div>
                }

                <div class="flex-grow-1 position-relative">
                    <!-- Normal Main Image -->
                    <div id="mainImageContainer" class="bg-white border rounded-4 d-flex align-items-center justify-content-center shadow-sm w-100" style="aspect-ratio: 1 / 1; overflow:hidden; position: relative; cursor: zoom-in;" data-bs-toggle="modal" data-bs-target="#imageModal">
                        <img id="mainImage" src="@ResolveImage(Model.ImageUrl ?? Model.ImageUrls?.FirstOrDefault())" alt="@Model.Name" class="img-fluid w-100 h-100" style="object-fit:contain;" />
                        <!-- The lens representing hover area -->
                        <div id="zoomLens" style="position: absolute; border: 1px solid #d4d4d4; background: rgba(255, 255, 255, 0.4); display: none; pointer-events: none;"></div>
                    </div>

                    <!-- Main Left Arrow -->
                    <button type="button" class="btn btn-light rounded-circle position-absolute start-0 ms-2 shadow-sm d-flex align-items-center justify-content-center top-50 translate-middle-y" id="mainPrevBtn" style="width:40px; height:40px; z-index:5;">
                        <i class="fas fa-chevron-left"></i>
                    </button>

                    <!-- Main Right Arrow -->
                    <button type="button" class="btn btn-light rounded-circle position-absolute end-0 me-2 shadow-sm d-flex align-items-center justify-content-center top-50 translate-middle-y" id="mainNextBtn" style="width:40px; height:40px; z-index:5;">
                        <i class="fas fa-chevron-right"></i>
                    </button>
                </div>
            </div>

            <!-- Hidden portal for Amazon-like hover zoom, positioned to the right of the main image container -->
            <div id="zoomResult" class="shadow-lg border bg-white rounded-3" style="display:none; position: absolute; left: 100%; top: 0; width: 500px; height: 500px; z-index: 1050; background-repeat: no-repeat; margin-left: 20px; pointer-events: none;"></div>
        </section>

        <section class="col-12 col-md-6 col-lg-6" aria-labelledby="product-details">
            <div class="ps-lg-4">
                @if (!string.IsNullOrWhiteSpace(Model.Brand))
                {
                    <span class="text-uppercase tracking-wider small fw-bold text-primary mb-2 d-block">@Model.Brand</span>
                }

                <h1 id="product-details" class="display-6 fw-bold mb-3">@Model.Name</h1>

                <div class="d-flex align-items-center mb-4">
                    <div class="me-2" aria-hidden="true">
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= Math.Round(Model.Rating))
                            {
                                <i class="fas fa-star text-warning"></i>
                            }
                            else
                            {
                                <i class="far fa-star text-muted op-50"></i>
                            }
                        }
                    </div>
                    <span class="small text-muted fw-medium">@Model.Rating.ToString("F1") (@Model.ReviewCount review@(Model.ReviewCount == 1 ? "" : "s"))</span>
                </div>

                <div class="mb-4">
                    <div class="d-flex align-items-baseline gap-3 mb-2">
                        <span class="fs-2 fw-bold text-dark">@Model.Price.ToString("C")</span>
                        @if (Model.OriginalPrice.HasValue && Model.OriginalPrice.Value > Model.Price)
                        {
                            <span class="fs-5 text-muted text-decoration-line-through mb-0">@Model.OriginalPrice.Value.ToString("C")</span>
                        }
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        @if (Model.Discount.HasValue && Model.Discount.Value > 0)
                        {
                            <span class="badge bg-danger rounded-pill px-3 py-2 fw-medium">Save @Model.Discount.Value%</span>
                        }
                        @if (Model.IsFlashDeal)
                        {
                            <span class="badge bg-warning text-dark rounded-pill px-3 py-2 fw-medium"><i class="fas fa-bolt me-1"></i> Flash Deal</span>
                        }
                        @if (Model.IsFeatured)
                        {
                            <span class="badge bg-dark rounded-pill px-3 py-2 fw-medium">Featured</span>
                        }
                        @if (Model.IsBestSeller)
                        {
                            <span class="badge bg-success rounded-pill px-3 py-2 fw-medium"><i class="fas fa-award me-1"></i> Best Seller</span>
                        }
                    </div>
                </div>

                <p class="text-secondary lh-lg mb-4">@Model.Description</p>

                <hr class="my-4" />

                <div class="row g-3 mb-4 mt-2 align-items-end">
                    <div class="col-auto">
                        <label for="quantity" class="form-label small fw-bold text-uppercase text-secondary">Quantity</label>
                        <div class="input-group input-group-lg shadow-sm" style="width: 150px;">
                            <button class="btn btn-outline-secondary px-3 border-secondary bg-light" type="button" onclick="decrementQty()" @(Model.StockQuantity <= 0 ? "disabled" : "")><i class="fas fa-minus fs-6"></i></button>
                            <input type="number" id="quantity" class="form-control text-center px-2 border-secondary border-start-0 border-end-0 fw-bold hide-spinners" value="@(Model.StockQuantity > 0 ? 1 : 0)" min="@(Model.StockQuantity > 0 ? 1 : 0)" max="@Model.StockQuantity" aria-label="Quantity" @(Model.StockQuantity <= 0 ? "disabled" : "") oninput="if(this.value > @Model.StockQuantity) this.value = @Model.StockQuantity;" onblur="if(!this.value || this.value < 1) this.value = @(Model.StockQuantity > 0 ? 1 : 0);">
                            <button class="btn btn-outline-secondary px-3 border-secondary bg-light" type="button" onclick="incrementQty()" @(Model.StockQuantity <= 0 ? "disabled" : "")><i class="fas fa-plus fs-6"></i></button>
                        </div>
                    </div>
                    <div class="col mb-2 d-flex">
                        <span class="badge @(Model.StockQuantity > 0 ? "bg-success" : "bg-danger") px-3 py-2 rounded-pill fw-medium fs-6 shadow-sm d-flex align-items-center">
                            <i class="fas @(Model.StockQuantity > 0 ? "fa-check-circle" : "fa-times-circle") me-2"></i>
                            @((Model.StockQuantity > 0) ? $"{Model.StockQuantity} in stock" : "Out of stock")
                        </span>
                    </div>
                </div>

                <div class="d-flex flex-column flex-sm-row gap-3 mt-4">
                    <button id="addToCartBtn" class="btn btn-dark btn-lg flex-grow-1 py-3 fw-bold shadow" style="transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='translateY(0)'" type="button" onclick="addToCart('@Model.Id', event)" @(Model.StockQuantity <= 0 ? "disabled" : "")>
                        <i class="fas fa-shopping-cart me-2"></i> @(Model.StockQuantity > 0 ? "Add to Cart" : "Notify Me")
                    </button>
                    <button class="btn btn-outline-dark btn-lg py-3 px-4 fw-bold shadow-sm" type="button" aria-label="Add to Wishlist" title="Save to Wishlist" style="transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='translateY(0)'">
                        <i class="far fa-heart fs-5"></i>
                    </button>
                </div>

                <div class="card bg-light border-0 mt-4 rounded-4">
                    <div class="card-body">
                        <ul class="list-unstyled mb-0 small text-secondary">
                            <li class="mb-2"><i class="fas fa-truck text-primary me-2 w-15px"></i> Free shipping on orders over $50</li>
                            <li class="mb-2"><i class="fas fa-undo text-primary me-2 w-15px"></i> Flexible 30-day return policy</li>
                            <li><i class="fas fa-shield-alt text-primary me-2 w-15px"></i> 1-year warranty included</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <!-- Product Features Tabs -->
    <div class="mt-5 pt-4">
        <ul class="nav nav-pills nav-fill mb-4 gap-2 bg-light p-2 rounded-pill shadow-sm" id="productTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active rounded-pill fw-bold border-0 px-4 py-3 text-dark transition-all custom-tab-btn" id="description-tab" data-bs-target="#descriptionTab" type="button" role="tab" aria-controls="descriptionTab" aria-selected="true" data-bs-toggle="tab">
                    <i class="fas fa-align-left me-2 opacity-75"></i>Description
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link rounded-pill fw-bold border-0 px-4 py-3 text-dark transition-all custom-tab-btn" id="specs-tab" data-bs-target="#specsTab" type="button" role="tab" aria-controls="specsTab" aria-selected="false" data-bs-toggle="tab">
                    <i class="fas fa-list me-2 opacity-75"></i>Specifications
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link rounded-pill fw-bold border-0 px-4 py-3 text-dark transition-all custom-tab-btn" id="reviews-tab" data-bs-target="#reviewsTab" type="button" role="tab" aria-controls="reviewsTab" aria-selected="false" data-bs-toggle="tab">
                    <i class="fas fa-star me-2 text-warning"></i>Reviews (@Model.ReviewCount)
                </button>
            </li>
        </ul>

        <div class="tab-content" id="productTabsContent">
            <div class="tab-pane fade show active p-4 p-md-5 bg-white rounded-5 shadow-sm border" id="descriptionTab" role="tabpanel" aria-labelledby="description-tab">
                <h3 class="h4 fw-bold mb-4 text-dark border-bottom pb-3"><i class="fas fa-info-circle me-2 text-primary"></i>Product Description</h3>
                <div class="text-secondary lh-lg fs-6 text-wrap text-break" style="white-space: pre-line;">@Model.Description</div>
            </div>

            <div class="tab-pane fade p-4 p-md-5 bg-white rounded-5 shadow-sm border" id="specsTab" role="tabpanel" aria-labelledby="specs-tab">
                <h3 class="h4 fw-bold mb-4 text-dark border-bottom pb-3"><i class="fas fa-cogs me-2 text-primary"></i>Technical Specifications</h3>
                @if (Model.Specifications != null && Model.Specifications.Count > 0)
                {
                    <div class="row g-4 mt-2">
                        @foreach (var spec in Model.Specifications)
                        {
                            <div class="col-12 col-md-6 col-lg-4">
                                <div class="bg-light rounded-4 p-4 h-100 border border-white shadow-sm d-flex flex-column justify-content-center transition-all hover-lift">
                                    <div class="small fw-bold text-uppercase text-primary mb-2" style="letter-spacing: 1px;">@spec.Key</div>
                                    <div class="fw-semibold text-dark fs-5 text-break">@spec.Value</div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 bg-light rounded-4 mt-3 border border-dashed">
                        <i class="fas fa-clipboard-list fa-3x text-muted mb-3" style="opacity: 0.3;"></i>
                        <p class="text-muted fw-medium fs-5 mb-0">No specifications have been added for this product.</p>
                    </div>
                }
            </div>

            <div class="tab-pane fade p-4 p-md-5 bg-white rounded-5 shadow-sm border" id="reviewsTab" role="tabpanel" aria-labelledby="reviews-tab">
                <div class="row mb-5 border-bottom pb-5">
                    <div class="col-md-4 mb-4 mb-md-0 text-center border-end">
                        <h3 class="h4 fw-bold mb-4">Customer Rating</h3>
                        <div class="display-2 fw-bold text-dark mb-2">@Model.Rating.ToString("F1")</div>
                        <div class="fs-4 mb-2">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= Math.Round(Model.Rating))
                                {
                                    <i class="fas fa-star text-warning"></i>
                                }
                                else
                                {
                                    <i class="far fa-star text-muted op-50"></i>
                                }
                            }
                        </div>
                        <p class="text-muted small">Based on @Model.ReviewCount reviews</p>
                    </div>
                    <div class="col-md-8 ps-md-4 d-flex align-items-center justify-content-center flex-column py-5">
                        <i class="fas fa-comment-dots display-1 text-light mb-3"></i>
                        <p class="text-muted text-center mb-3">Share your thoughts with other customers</p>
                        <button class="btn btn-outline-dark fw-bold px-4 py-2" data-bs-toggle="modal" data-bs-target="#reviewModal">Write a Review</button>
                    </div>
                </div>

                <div class="reviews-list mt-4">
                    <h4 class="h5 fw-bold mb-4">Recent Reviews</h4>
                    <!-- Example Review 1 -->
                    <div class="card border-0 bg-light mb-3 rounded-4">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="d-flex align-items-center">
                                    <div class="bg-secondary text-white rounded-circle d-flex justify-content-center align-items-center fw-bold me-3" style="width: 45px; height: 45px;">
                                        JD
                                    </div>
                                    <div>
                                        <h5 class="mb-0 fw-bold fs-6">John Doe</h5>
                                        <small class="text-muted">October 24, 2023</small>
                                    </div>
                                </div>
                                <div class="text-warning small">
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                </div>
                            </div>
                            <h6 class="fw-bold mb-2">Great Product, highly recommend!</h6>
                            <p class="text-secondary mb-0">This product exceeded my expectations. The quality is fantastic and it arrived very quickly. I've been using it for a week now and have no complaints.</p>
                        </div>
                    </div>
                    <!-- Example Review 2 -->
                    <div class="card border-0 bg-light mb-3 rounded-4">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="d-flex align-items-center">
                                    <div class="bg-secondary text-white rounded-circle d-flex justify-content-center align-items-center fw-bold me-3" style="width: 45px; height: 45px;">
                                        AS
                                    </div>
                                    <div>
                                        <h5 class="mb-0 fw-bold fs-6">Alice Smith</h5>
                                        <small class="text-muted">November 2, 2023</small>
                                    </div>
                                </div>
                                <div class="text-warning small">
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="far fa-star"></i>
                                </div>
                            </div>
                            <h6 class="fw-bold mb-2">Good, but could be better</h6>
                            <p class="text-secondary mb-0">It generally works well and the build quality is decent. However, I found some minor issues that prevent me from giving it a full 5 stars.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Write Review Modal -->
<div class="modal fade" id="reviewModal" tabindex="-1" aria-labelledby="reviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header px-4 py-3 border-bottom">
                <h5 class="modal-title fw-bold h5 mb-0" id="reviewModalLabel">Write a Review</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="writeReviewForm">
                    <div class="mb-4 text-center">
                        <label class="form-label fw-bold d-block">Overall Rating</label>
                        <div class="fs-2 text-warning" style="cursor: pointer;" id="starRatingSelector">
                            <i class="far fa-star star-select" data-rating="1"></i>
                            <i class="far fa-star star-select" data-rating="2"></i>
                            <i class="far fa-star star-select" data-rating="3"></i>
                            <i class="far fa-star star-select" data-rating="4"></i>
                            <i class="far fa-star star-select" data-rating="5"></i>
                        </div>
                        <input type="hidden" id="selectedRating" name="rating" value="0" required />
                    </div>

                    <div class="mb-3">
                        <label for="reviewTitle" class="form-label fw-bold small text-uppercase">Review Title</label>
                        <input type="text" class="form-control bg-light border-0" id="reviewTitle" placeholder="Summary of your review" required>
                    </div>

                    <div class="mb-4">
                        <label for="reviewText" class="form-label fw-bold small text-uppercase">Review Details</label>
                        <textarea class="form-control bg-light border-0" id="reviewText" rows="4" placeholder="What did you like or dislike?" required></textarea>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-dark fw-bold py-2">Submit Review</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Fullscreen Image Modal (Lightbox) -->
<div class="modal fade" id="imageModal" tabindex="-1" aria-labelledby="imageModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content rounded-4 shadow-lg border-0">
            <div class="modal-header px-4 py-3">
                <h5 class="modal-title fw-bold h5 mb-0 text-truncate" id="imageModalLabel">@Model.Name</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body position-relative d-flex justify-content-center align-items-center bg-white p-4" style="min-height: 60vh; overflow: hidden;">
                <!-- Left Arrow -->
                <button class="btn btn-light rounded-circle position-absolute start-0 ms-2 ms-md-4 shadow-sm border" id="prevBtn" style="width:50px; height:50px; z-index:10;">
                    <i class="fas fa-chevron-left"></i>
                </button>

                <div class="d-flex justify-content-center align-items-center w-100 h-100">
                    <img id="modalImage" src="@ResolveImage(Model.ImageUrl ?? Model.ImageUrls?.FirstOrDefault())" class="img-fluid rounded" style="max-height: 75vh; object-fit: contain; cursor: zoom-in;" />
                </div>

                <!-- Right Arrow -->
                <button class="btn btn-light rounded-circle position-absolute end-0 me-2 me-md-4 shadow-sm border" id="nextBtn" style="width:50px; height:50px; z-index:10;">
                    <i class="fas fa-chevron-right"></i>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        /* Hide number spinners for a cleaner quantity box */
        input[type=number].hide-spinners::-webkit-inner-spin-button,
        input[type=number].hide-spinners::-webkit-outer-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }
        input[type=number].hide-spinners {
            -moz-appearance: textfield;
        }

        /* Enhance Product Tabs */
        #productTabs .custom-tab-btn {
            background-color: transparent;
            color: #495057 !important;
            transition: all 0.3s ease;
        }
        #productTabs .custom-tab-btn:hover {
            background-color: #e9ecef;
        }
        #productTabs .custom-tab-btn.active {
            background-color: #212529 !important;
            color: #fff !important;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        #productTabs .custom-tab-btn.active i {
            color: #fff !important;
            opacity: 1 !important;
        }

        .hover-lift {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .hover-lift:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.05) !important;
        }
    </style>
    <script>
        var productImages = [];
        @if (Model.ImageUrls != null)
        {
            @foreach (var img in Model.ImageUrls)
            {
                <text>productImages.push('@ResolveImage(img)');</text>
            }
        }

        if (productImages.length === 0) {
            productImages.push('@ResolveImage(Model.ImageUrl)');
        }
    </script>
    <script src="~/js/shop-product.js"></script>
    <script src="~/js/cart.js"></script>
}
