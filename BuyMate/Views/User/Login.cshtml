@using BuyMate.DTO.ViewModels.User
@model LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "_AuthLayout";
}

<div class="container" style="max-width: 32rem;">
    <div class="card p-4 p-md-5 mt-4 border-0 shadow-lg rounded-4 hover-lift transition-all bg-white mx-auto">
        <div class="text-center mb-5">
            <div class="d-inline-flex justify-content-center align-items-center bg-primary bg-opacity-10 text-primary rounded-circle mb-3 shadow-sm" style="width: 70px; height: 70px;">
                <i class="fas fa-sign-in-alt fs-2"></i>
            </div>
            <h1 class="h3 fw-bold mb-2 text-dark">Welcome Back</h1>
            <p class="text-secondary fs-6 mb-0">Sign in to your account to continue</p>
        </div>

        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-4">
                <label asp-for="Email" class="form-label small fw-bold text-uppercase text-secondary" style="letter-spacing: 0.5px;">Email Address</label>
                <input asp-for="Email" type="email" class="form-control bg-light border-0 px-4 py-3 rounded-3 shadow-none" placeholder="Enter your email" />
                <span asp-validation-for="Email" class="small text-danger fw-medium mt-1 d-block"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Password" class="form-label small fw-bold text-uppercase text-secondary" style="letter-spacing: 0.5px;">Password</label>
                <input asp-for="Password" id="LoginPassword" type="password" class="form-control bg-light border-0 px-4 py-3 rounded-3 shadow-none" placeholder="Enter your password" />
                <span asp-validation-for="Password" class="small text-danger fw-medium mt-1 d-block"></span>
            </div>

            <div class="d-flex align-items-center justify-content-between mb-4">
                <div class="form-check d-flex align-items-center gap-2 mb-0">
                    <input asp-for="RememberMe" type="checkbox" class="form-check-input mt-0 shadow-sm" id="rememberMeChk" style="width: 1.2rem; height: 1.2rem; cursor: pointer;" />
                    <label asp-for="RememberMe" class="form-check-label small fw-bold text-dark" style="cursor: pointer;"></label>
                </div>
                <a href="#" class="small fw-bold text-primary text-decoration-none d-inline-block" style="transition: opacity 0.2s;" onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'">Forgot password?</a>
            </div>

            <div class="mb-4">
                <div class="form-check d-flex align-items-center gap-2">
                    <input id="showPasswordLogin" type="checkbox" class="form-check-input mt-0 shadow-sm" style="width: 1.2rem; height: 1.2rem; cursor: pointer;" />
                    <label for="showPasswordLogin" class="form-check-label small fw-medium text-secondary" style="cursor: pointer;">Show password</label>
                </div>
            </div>

            <button type="submit" class="btn btn-dark w-100 btn-lg rounded-pill fw-bold shadow-sm hover-lift mb-4 py-3"><i class="fas fa-sign-in-alt me-2"></i>Sign In</button>
        </form>

        <div class="text-center border-top pt-4">
            <p class="fs-6 text-secondary mb-0">
                Don't have an account?
                <a asp-action="Register" class="fw-bold text-primary text-decoration-none ms-1 hover-lift d-inline-block">Sign up here</a>
            </p>
        </div>
    </div>
</div>

<script src="~/js/user-login.js"></script>
