@using BuyMate.DTO.ViewModels.User
@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
    Layout = "_AuthLayout";
}

<div class="container" style="max-width: 42rem;">
    <div class="card p-4 p-md-5 mt-4 border-0 shadow-lg rounded-4 hover-lift transition-all bg-white mx-auto">
        <div class="text-center mb-5">
            <div class="d-inline-flex justify-content-center align-items-center bg-dark bg-opacity-10 text-dark rounded-circle mb-3 shadow-sm" style="width: 70px; height: 70px;">
                <i class="fas fa-user-plus fs-2"></i>
            </div>
            <h1 class="h3 fw-bold mb-2 text-dark">Create Account</h1>
            <p class="text-secondary fs-6 mb-0">Join BUYMATE and start shopping today</p>
        </div>

        <form asp-action="Register" method="post" asp-antiforgery="true">
            <div class="row g-4 mb-4">
                <div class="col-12 col-sm-6">
                    <label asp-for="FirstName" class="form-label small fw-bold text-uppercase text-secondary" style="letter-spacing: 0.5px;">First Name</label>
                    <input asp-for="FirstName" type="text" class="form-control bg-light border-0 px-4 py-3 rounded-3 shadow-none" placeholder="First name" />
                    <span asp-validation-for="FirstName" class="small text-danger fw-medium mt-1 d-block"></span>
                </div>
                <div class="col-12 col-sm-6">
                    <label asp-for="LastName" class="form-label small fw-bold text-uppercase text-secondary" style="letter-spacing: 0.5px;">Last Name</label>
                    <input asp-for="LastName" type="text" class="form-control bg-light border-0 px-4 py-3 rounded-3 shadow-none" placeholder="Last name" />
                    <span asp-validation-for="LastName" class="small text-danger fw-medium mt-1 d-block"></span>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="Email" class="form-label small fw-bold text-uppercase text-secondary" style="letter-spacing: 0.5px;">Email Address</label>
                <input asp-for="Email" type="email" class="form-control bg-light border-0 px-4 py-3 rounded-3 shadow-none" placeholder="Enter your email" />
                <span asp-validation-for="Email" class="small text-danger fw-medium mt-1 d-block"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Phone" class="form-label small fw-bold text-uppercase text-secondary" style="letter-spacing: 0.5px;">Phone Number</label>
                <input asp-for="Phone" type="tel" class="form-control bg-light border-0 px-4 py-3 rounded-3 shadow-none" placeholder="Enter your phone number" />
                <span asp-validation-for="Phone" class="small text-danger fw-medium mt-1 d-block"></span>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-12 col-sm-6">
                    <label asp-for="Password" class="form-label small fw-bold text-uppercase text-secondary" style="letter-spacing: 0.5px;">Password</label>
                    <input asp-for="Password" id="Password" type="password" class="form-control bg-light border-0 px-4 py-3 rounded-3 shadow-none" placeholder="Create password" />
                    <span asp-validation-for="Password" class="small text-danger fw-medium mt-1 d-block"></span>
                </div>
                <div class="col-12 col-sm-6">
                    <label asp-for="ConfirmPassword" class="form-label small fw-bold text-uppercase text-secondary" style="letter-spacing: 0.5px;">Confirm Password</label>
                    <input asp-for="ConfirmPassword" id="ConfirmPassword" type="password" class="form-control bg-light border-0 px-4 py-3 rounded-3 shadow-none" placeholder="Confirm password" />
                    <span asp-validation-for="ConfirmPassword" class="small text-danger fw-medium mt-1 d-block"></span>
                </div>
            </div>

            <div class="mb-4">
                <div class="form-check d-flex align-items-center gap-2">
                    <input id="showPasswordRegister" type="checkbox" class="form-check-input mt-0 shadow-sm" style="width: 1.2rem; height: 1.2rem; cursor: pointer;" />
                    <label for="showPasswordRegister" class="form-check-label small fw-medium text-secondary" style="cursor: pointer;">Show passwords</label>
                </div>
            </div>

            <button type="submit" class="btn btn-dark w-100 btn-lg rounded-pill fw-bold shadow-sm hover-lift mb-4 py-3"><i class="fas fa-user-plus me-2"></i>Create Account</button>
        </form>

        <div class="text-center border-top pt-4">
            <p class="fs-6 text-secondary mb-0">
                Already have an account?
                <a asp-action="Login" class="fw-bold text-primary text-decoration-none ms-1 hover-lift d-inline-block">Sign in here</a>
            </p>
        </div>
    </div>
</div>

<script src="~/js/user-register.js"></script>
